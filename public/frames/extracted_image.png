function safeTarget(node) {
  if (!node || node.nodeType !== 1) return '(unknown)';
  var parts = [], depth = 0;
  while (node && node.nodeType === 1 && depth++ < 4) {
    var part = node.tagName.toLowerCase();
    if (node.id) { parts.unshift(part + '#' + node.id); break; }
    if (typeof node.className === 'string' && node.className.trim()) part += '.' + node.className.trim().split(/\s+/).slice(0, 2).join('.');
    parts.unshift(part);
    node = node.parentElement;
  }
  return parts.join('>').slice(0, 100);
}
function report(metric) {
  if (typeof window.gtag !== 'function' || window.mwtAnalyticsDisabled) return;
  var a = metric.attribution || {};
  var inp = metric.name === 'INP';
  var script = a.longestScript && a.longestScript.entry;
  var source = script && (script.sourceURL || script.invoker) || '(none)';
  source = source.replace(/^https?:\/\//, '').split(/[?#]/)[0].slice(0, 100);
  function ms(n) { return Math.max(0, Math.round(n || 0)); }
  var fields = {
    metric_name: metric.name,
    metric_unit: inp ? 'ms' : 'x1000',
    metric_value: Math.round(metric.value * (inp ? 1 : 1000)),
    metric_rating: metric.rating,
    metric_id: metric.id,
    vitals_version: 'web-vitals-6.2.1-inp1',
    vitals_path: location.pathname.slice(0, 100),
    vitals_lang: (document.documentElement.lang || 'en').slice(0, 12),
    vitals_target: (inp ? a.interactionTarget || '(unknown)' : a.largestShiftTarget || '(none)').slice(0, 100),
    vitals_detail: inp ? (a.interactionType || 'interaction') + '|delay' + ms(a.inputDelay) + '|proc' + ms(a.processingDuration) + '|paint' + ms(a.presentationDelay) : '',
    vitals_script: inp ? source : '(none)',
    vitals_count: inp ? (performance.interactionCount || 0) : 0,
    non_interaction: true,
    page_location: location.origin + location.pathname,
    page_referrer: '',
    transport_type: 'beacon'
  };
  if (inp) {
    fields.inp_input_delay = ms(a.inputDelay);
    fields.inp_processing_duration = ms(a.processingDuration);
    fields.inp_presentation_delay = ms(a.presentationDelay);
    fields.inp_load_state = a.loadState;
    fields.inp_script_phase = a.longestScript ? a.longestScript.subpart : '(none)';
  }
  try { window.gtag('event', 'web_vitals', fields); } catch (e) {}
}
