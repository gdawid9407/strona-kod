<style>
  /* The overlay scrolls, the card centers via margin:auto — unlike flex
     centering this never clips the card's top edge when large fonts or a
     short viewport make the card taller than the screen. */
  #mwt-zipgate{position:fixed;inset:0;z-index:2147483647;display:none;background:rgba(15,23,42,.55);padding:16px;overflow-y:auto;-webkit-overflow-scrolling:touch}
  #mwt-zipgate.on{display:flex}
  #mwt-zipgate .zg-card{position:relative;margin:auto;background:#fff;border-radius:14px;max-width:430px;width:100%;padding:26px 26px 22px;box-shadow:0 24px 60px -12px rgba(15,23,42,.45);font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:#0f172a;text-align:left}
  #mwt-zipgate .zg-x{position:absolute;top:10px;right:12px;border:0;background:none;color:#556072;font-size:1.5rem;line-height:1;cursor:pointer;padding:4px}
  #mwt-zipgate .zg-x:hover{color:#475569}
  #mwt-zipgate .zg-badge{display:inline-block;background:#dcfce7;color:#14532d;font-weight:800;font-size:.7rem;letter-spacing:.08em;padding:3px 9px;border-radius:999px;text-transform:uppercase;margin-bottom:10px}
  #mwt-zipgate h3{margin:0 0 8px;font-size:1.18rem;font-weight:800;letter-spacing:-.01em}
  #mwt-zipgate .zg-free{margin:0 0 12px;color:#475569;font-size:.93rem}
  #mwt-zipgate ul{list-style:none;margin:0 0 14px;padding:0;display:flex;flex-direction:column;gap:6px}
  #mwt-zipgate li{position:relative;padding-left:24px;font-size:.92rem}
  #mwt-zipgate li:before{content:"\2713";position:absolute;left:2px;top:0;color:#16a34a;font-weight:700}
  #mwt-zipgate .zg-price{margin:0 0 14px;color:#475569;font-size:.85rem}
  #mwt-zipgate .zg-cta{display:block;text-align:center;background:#16a34a;color:#fff;font-weight:700;font-size:.98rem;text-decoration:none;padding:12px 16px;border-radius:10px}
  #mwt-zipgate .zg-cta:hover{background:#14532d}
  #mwt-zipgate .zg-or{display:flex;align-items:center;gap:10px;margin:14px 0 10px;color:#556072;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}
  #mwt-zipgate .zg-or:before,#mwt-zipgate .zg-or:after{content:"";flex:1;height:1px;background:#e2e8f0}
  #mwt-zipgate .zg-reward{display:none}
  #mwt-zipgate .zg-reward-btn{display:block;width:100%;background:#fff;border:1.5px solid #cbd5e1;border-radius:10px;color:#0f172a;font-weight:700;font-size:.95rem;padding:11px 16px;cursor:pointer}
  #mwt-zipgate .zg-reward-btn:hover{border-color:#94a3b8;background:#f8fafc}
  #mwt-zipgate .zg-reward-note{margin:7px 0 0;color:#556072;font-size:.76rem;text-align:center}
  #mwt-zipgate .zg-later{display:block;width:100%;margin-top:10px;border:0;background:none;color:#64748b;font-size:.86rem;cursor:pointer;text-decoration:underline;text-underline-offset:2px;padding:4px}
  #mwt-zipgate .zg-foot{margin:12px 0 0;color:#556072;font-size:.76rem;text-align:center}
</style>
<div id="mwt-zipgate" role="dialog" aria-modal="true" aria-labelledby="mwt-zipgate-title"></div>
<template id="mwt-zipgate-card">
  <div class="zg-card">
    <button type="button" class="zg-x" id="mwt-zipgate-x" aria-label="Close">&times;</button>
    <span class="zg-badge">Pro feature</span>
    
    <h3 id="mwt-zipgate-title">Download everything as one ZIP with Pro</h3>
    <p class="zg-free">Downloading files one at a time stays free — no limit. The one-click ZIP of all your files, plus the rest of Pro, takes seconds to unlock:</p>
    <ul>
      <li>Batch ZIP downloads on all image, PDF & video tools</li>
    
      <li>60 runs/day on capped tools (20× the free plan)</li>
      <li>Ads off, everywhere on the site</li>
      <li>My Toolbox unlocked — unlimited saves + Automatic Mode</li>
    </ul>
    <p class="zg-price">From <strong>$3.33/month</strong> billed annually &middot; cancel anytime &middot; no account needed &middot; unlocks instantly</p>
    <span id="zg-exp-title" hidden>Download this result as a file with Pro</span>
    <span id="zg-exp-free" hidden>Reading the result on this page stays free — nothing is hidden. Taking it away as a PDF or JPG, plus the rest of Pro, takes seconds to unlock:</span>
    <span id="zg-exp-bullet" hidden>PDF and JPG downloads of any tool's result</span>
    <span id="zg-exp-later" hidden>Not now — reading it on the page is enough</span>
    <span id="zg-exp-reward" hidden>Watch a short ad — unlock PDF & JPG on this tool for the rest of today</span>
    <a rel="nofollow" class="zg-cta" data-mwt-zipgate-cta="pro"
       href="/premium-subscription/?tier=pro&amp;from=_video_to_image_extractor_&amp;src=zipgate">See Pro plans &rarr;</a>
    
    <div class="zg-reward" id="mwt-zg-reward">
      <div class="zg-or">or</div>
      <button type="button" class="zg-reward-btn" id="mwt-zg-reward-btn">Watch a short ad — unlock PDF & JPG on this tool for the rest of today</button>
      <p class="zg-reward-note">This download only. No account, no card.</p>
    </div>
    
    
    <button type="button" class="zg-later" id="mwt-zipgate-later">Not now — I'll download files one by one</button>
    
    <p class="zg-foot">Premium includes everything in Pro, with no daily caps at all.</p>
  </div>
</template>

<script>
(function () {
  if (window.mwtRequestUsageStatus) return;
  var pending = Object.create(null);
  // Share only in-flight reads. Never reuse settled quota data after a
  // reserve/commit/refund, and never cache a user's quota in shared storage.
  window.mwtRequestUsageStatus = function (module, lang) {
    var url = '/_api/usage/status/?module=' + encodeURIComponent(module) +
      '&lang=' + encodeURIComponent(lang || 'en');
    var tv = (location.search || '').match(/[?&]tv=([ab])(?:&|$)/);
    if (tv) url += '&tv=' + tv[1];
    if (!pending[url]) {
      var request = Promise.resolve().then(function () {
        return fetch(url, {credentials: 'same-origin', cache: 'no-store'});
      }).then(function (response) { return response.ok ? response.json() : null; });
      pending[url] = request;
      function release() { if (pending[url] === request) delete pending[url]; }
      request.then(release, release);
    }
    return pending[url];
  };
})();
</script>

<script>
(function () {
  var SEL  = "#download\u002Dall\u002Dbtn";
  var EXPSEL = "#mwt\u002Dexport\u002Dpdf, #mwt\u002Dexport\u002Djpg";
  var ALLSEL = SEL && EXPSEL ? (SEL + ", " + EXPSEL) : (SEL || EXPSEL);
  var MOD  = "_video_to_image_extractor_";
  var LANG = "en";
  var GATE_KIND = "zip";
  var AD   = "/71161633,21815091813/MINWBTOOL_miniwebtool/rewarded_ad";
  var ADTEST = false;
  var modal = document.getElementById('mwt-zipgate');
  var cardTpl = document.getElementById('mwt-zipgate-card');
  if (!ALLSEL || !MOD || !modal || !cardTpl) return;

  try {
    if (modal.parentNode !== document.body) document.body.appendChild(modal);
  } catch (e) {}

  var hydrated = false;
  function hydrate() {
    if (hydrated) return;
    hydrated = true;
    modal.appendChild(cardTpl.content.cloneNode(true));
    var x = modal.querySelector('#mwt-zipgate-x');
    if (x) x.addEventListener('click', hideModal);
    var later = modal.querySelector('#mwt-zipgate-later');
    if (later) later.addEventListener('click', hideModal);
    if (AD) {
      var rewardBtn = modal.querySelector('#mwt-zg-reward-btn');
      if (rewardBtn) rewardBtn.addEventListener('click', onRewardBtnClick);
    }
  }

  var state = null;
  var pending = null;
  var impressionFired = false;
  var lastFocus = null;

  var adSlot = null, adReady = null, adRequested = false;
  var adGranted = false, adOfferLogged = false, adBound = false;
  var rewardEl = null, pendingEl = null, adTarget = null;

  function ga(name, params) {
    if (typeof gtag !== 'function') return;
    try { gtag('event', name, params); } catch (e) {}
  }

  function decide(tier, isPaid) {
    return (tier === 'pro' || tier === 'premium' || isPaid) ? 'allow' : 'gate';
  }

  function tierFromQuota() {
    var q = window.__mwtQuota;
    return (q && q.live && q.tier) ? q.tier : null;
  }

  function resolveState() {
    if (state) return Promise.resolve(state);
    var t = tierFromQuota();
    if (t) { state = decide(t, false); return Promise.resolve(state); }
    if (!pending) {
      pending = window.mwtRequestUsageStatus(MOD, LANG)
        .then(function (d) {
          state = d ? decide(d.tier, d.is_paid) : 'allow';
          return state;
        })
        .catch(function () { state = 'allow'; return state; });
    }
    return pending;
  }

  var zipCopy = null;

  function isExportEl(el) {
    return !!(EXPSEL && el.closest && el.closest(EXPSEL));
  }

  function canReward(el) {
    return !!el && (isExportEl(el) || GATE_KIND !== 'zip');
  }

  function updateRewardOffer() {
    var box = rewardBox();
    var eligible = canReward(pendingEl) && !!adReady;
    if (box) box.style.display = eligible ? 'block' : 'none';
    if (eligible && !adOfferLogged) {
      adOfferLogged = true;
      ga('rewarded_offer_shown', { source_tool: MOD });
    }
  }

  function applyGateCopy(forExport) {
    hydrate();
    updateRewardOffer();
    var title = modal.querySelector('#mwt-zipgate-title');
    var free = modal.querySelector('.zg-free');
    var bullet = modal.querySelector('ul li');
    var later = modal.querySelector('#mwt-zipgate-later');
    var reward = modal.querySelector('#mwt-zg-reward-btn');
    if (!title || !free || !bullet) return;
    if (zipCopy === null) {
      zipCopy = {
        title: title.innerHTML, free: free.innerHTML, bullet: bullet.innerHTML,
        later: later ? later.innerHTML : '', reward: reward ? reward.innerHTML : ''
      };
    }
    var pick = function (id, fallback) {
      var el = modal.querySelector(id);
      return el ? el.innerHTML : fallback;
    };
    if (forExport) {
      title.innerHTML = pick('#zg-exp-title', zipCopy.title);
      free.innerHTML = pick('#zg-exp-free', zipCopy.free);
      bullet.innerHTML = pick('#zg-exp-bullet', zipCopy.bullet);
      if (later) later.innerHTML = pick('#zg-exp-later', zipCopy.later);
      if (reward) reward.innerHTML = pick('#zg-exp-reward', zipCopy.reward);
    } else {
      title.innerHTML = zipCopy.title;
      free.innerHTML = zipCopy.free;
      bullet.innerHTML = zipCopy.bullet;
      if (later) later.innerHTML = zipCopy.later;
      if (reward) reward.innerHTML = zipCopy.reward;
    }
  }

  function showModal() {
    hydrate();
    lastFocus = document.activeElement;
    modal.classList.add('on');
    var cta = modal.querySelector('.zg-cta');
    if (cta) try { cta.focus(); } catch (e) {}
    if (!impressionFired) {
      impressionFired = true;
      ga('zipgate_impression', { source_tool: MOD, tier: 'free' });
    }
  }

  function hideModal() {
    modal.classList.remove('on');
    if (lastFocus && lastFocus.focus) try { lastFocus.focus(); } catch (e) {}
  }

  modal.addEventListener('click', function (ev) {
    if (ev.target === modal) hideModal();                       
    var cta = ev.target.closest ? ev.target.closest('[data-mwt-zipgate-cta]') : null;
    if (cta) {
      ga('begin_checkout', { tier: 'pro', source_tool: MOD, trigger: 'zipgate' });
    }
  });
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape' && modal.classList.contains('on')) hideModal();
  });

  function expDay() {
    var d = new Date();
    return '' + d.getFullYear() + ('0' + (d.getMonth() + 1)).slice(-2) + ('0' + d.getDate()).slice(-2);
  }

  function expKey() { return 'mwt_exp_unlock:' + MOD + ':' + expDay(); }

  function expUnlocked() {
    try { return window.localStorage.getItem(expKey()) === '1'; } catch (e) { return false; }
  }

  function setExpUnlocked() {
    try {
      var ls = window.localStorage;
      ls.setItem(expKey(), '1');
      var today = expDay(), stale = [];
      for (var i = 0; i < ls.length; i++) {
        var k = ls.key(i);
        if (k && k.indexOf('mwt_exp_unlock:') === 0 && k.slice(-8) !== today) stale.push(k);
      }
      for (var j = 0; j < stale.length; j++) ls.removeItem(stale[j]);
    } catch (e) {}
  }

  function rewardBox() { return document.getElementById('mwt-zg-reward'); }

  function onAdReady(evt) {
    adReady = evt;
    updateRewardOffer();
  }

  function onAdGranted(evt) {
    adGranted = true;
    ga('rewarded_granted', {
      source_tool: MOD,
      reward_type: (evt && evt.payload && evt.payload.type) || ''
    });
  }

  function onAdClosed() {
    var box = rewardBox();
    if (box) box.style.display = 'none';
    try { googletag.destroySlots([adSlot]); } catch (e) {}
    adSlot = null; adReady = null; adRequested = false; adOfferLogged = false;
    if (adGranted) {
      adGranted = false;
      var target = adTarget;
      adTarget = null;
      if (canReward(target)) {
        rewardEl = target;
        if (isExportEl(target)) setExpUnlocked();
        hideModal();
        try { target.click(); } catch (e) {}
      }
    } else {
      ga('rewarded_dismissed', { source_tool: MOD });
      showModal();
    }
  }

  function stubAd() {
    var left = 5;
    var o = document.createElement('div');
    o.style.cssText = 'position:fixed;inset:0;z-index:2147483647;background:#0f172a;color:#fff;' +
      'display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;' +
      'font:16px/1.5 system-ui,-apple-system,sans-serif;text-align:center;padding:24px';
    o.innerHTML = '<div style="font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;opacity:.55">' +
      'DEBUG rewarded-ad stub</div><div style="font-size:2.6rem;font-weight:800">' +
      '<span id="mwt-zg-stub-n">5</span></div>' +
      '<button type="button" id="mwt-zg-stub-x" style="border:0;border-radius:8px;padding:9px 18px;' +
      'font-size:.9rem;cursor:pointer">Close early (forfeit reward)</button>';
    document.body.appendChild(o);
    var timer = null;
    function finish(granted) {
      if (timer) { clearInterval(timer); timer = null; }
      if (o.parentNode) o.parentNode.removeChild(o);
      if (granted) onAdGranted({ payload: { type: 'test', amount: 1 } });
      onAdClosed();
    }
    o.querySelector('#mwt-zg-stub-x').addEventListener('click', function () { finish(false); });
    timer = setInterval(function () {
      left -= 1;
      var n = o.querySelector('#mwt-zg-stub-n');
      if (n) n.textContent = String(left);
      if (left <= 0) finish(true);
    }, 1000);
  }

  function loadRewarded(el) {
    if (!canReward(el) || !AD || adRequested) return;
    hydrate();
    adRequested = true;
    if (ADTEST) { onAdReady({ makeRewardedVisible: stubAd }); return; }
    try { if (typeof window.loadf === 'function') window.loadf(); } catch (e) {}
    window.googletag = window.googletag || {};
    window.googletag.cmd = window.googletag.cmd || [];
    googletag.cmd.push(function () {
      try {
        var fmt = googletag.enums && googletag.enums.OutOfPageFormat;
        if (!fmt || !fmt.REWARDED) return;
        adSlot = googletag.defineOutOfPageSlot(AD, fmt.REWARDED);
        if (!adSlot) return;
        adSlot.addService(googletag.pubads());
        if (!adBound) {
          adBound = true;
          googletag.pubads().addEventListener('rewardedSlotReady', onAdReady);
          googletag.pubads().addEventListener('rewardedSlotGranted', onAdGranted);
          googletag.pubads().addEventListener('rewardedSlotClosed', onAdClosed);
        }
        googletag.enableServices();
        googletag.display(adSlot);
        googletag.pubads().refresh([adSlot]);
      } catch (e) { adRequested = false; }
    });
  }

  function onRewardBtnClick() {
    if (!adReady || !canReward(pendingEl)) return;
    adTarget = pendingEl;
    ga('rewarded_opt_in', { source_tool: MOD });
    var evt = adReady;
    adReady = null;
    hideModal();
    try { evt.makeRewardedVisible(); } catch (e) { showModal(); }
  }

  function prewarm(ev) {
    var el = ev.target && ev.target.closest ? ev.target.closest(ALLSEL) : null;
    if (!el) return;
    resolveState().then(function (s) { if (s === 'gate') loadRewarded(el); });
  }
  document.addEventListener('pointerover', prewarm, true);
  document.addEventListener('touchstart', prewarm, { capture: true, passive: true });

  document.addEventListener('click', function (ev) {
    var el = ev.target && ev.target.closest ? ev.target.closest(ALLSEL) : null;
    if (!el) return;
    if (rewardEl === el && canReward(el)) { rewardEl = null; return; }             
    if (isExportEl(el) && expUnlocked()) return;                
    if (state === 'allow') return;                              
    pendingEl = el;
    applyGateCopy(isExportEl(el));
    ev.preventDefault();
    ev.stopImmediatePropagation();
    ev.stopPropagation();
    if (state === 'gate') { loadRewarded(el); showModal(); return; }
    resolveState().then(function (s) {
      if (s === 'allow') {
        el.click();                                             
      } else {
        loadRewarded(el);
        showModal();
      }
    });
  }, true);
})();
</script>




<script id="mwt-next-config" type="application/json">{"module":"_video_to_image_extractor_","slug":"video-to-image-extractor","name":"Video to Image Extractor","lang":"en","max":2,"rules":[],"ui":{"next":"Next:","note":"Brought over from {name} — check the fields, then run.","clear":"Clear","newtab":"(opens in a new tab)","fbk":{"next":"Next step","scene":"Same situation","like":"More tools"}},"fb":[{"to":"_random_video_thumbnail_generator_","slug":"random-video-thumbnail-generator","url":"/random-video-thumbnail-generator/","g":"next","tname":"Random Video Thumbnail Generator","brief":"Upload a video and choose how many random thumbnails to generate.","paid":1},{"to":"_image_cropper_","slug":"image-cropper","url":"/image-cropper/","g":"next","tname":"Image Cropper","brief":"Crop a photo to 1:1, 16:9, 4:5, or another preset ratio.","paid":1},{"to":"_video_cropper_","slug":"video-cropper","url":"/video-cropper/","g":"scene","tname":"Video Cropper","brief":"Crop your videos online directly in your browser.","paid":1}]}</script>
<style>
  .mwt-next{margin:18px 0 10px;font-family:inherit}
  .mwt-next-k{font-size:.74rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#6d28d9;margin:0 0 7px 2px}
  .mwt-next-k.lead{font-size:.95rem;font-weight:700;letter-spacing:0;text-transform:none;color:#1e1b4b}
  a.mwt-next-main{display:flex;align-items:center;gap:14px;padding:15px 16px 15px 18px;border-radius:14px;text-decoration:none!important;color:#fff!important;background:linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%);box-shadow:0 6px 18px -8px rgba(79,70,229,.6);transition:transform .15s ease,box-shadow .15s ease}
  a.mwt-next-main:hover{transform:translateY(-1px);box-shadow:0 10px 24px -10px rgba(79,70,229,.75)}
  a.mwt-next-main:focus-visible{outline:3px solid #a5b4fc;outline-offset:2px}
  .mwt-next-txt{flex:1;min-width:0}
  .mwt-next .mwt-next-k{color:#6d28d9!important;background:none!important}
  .mwt-next .mwt-next-k.lead{color:#1e1b4b!important}
  .mwt-next .mwt-next-t{display:block!important;font-size:1.06rem!important;font-weight:700!important;line-height:1.35!important;color:#fff!important;background:none!important;text-transform:none!important;letter-spacing:normal!important}
  .mwt-next .mwt-next-s{display:block!important;margin-top:3px!important;font-size:.82rem!important;font-weight:500!important;line-height:1.4!important;color:#fff!important;opacity:.82;background:none!important;text-transform:none!important;letter-spacing:normal!important}
  .mwt-next .mwt-next-go{flex:none;display:flex!important;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.18)!important;color:#fff!important}
  .mwt-next-go svg{width:18px;height:18px}
  .mwt-next-more{display:flex;flex-wrap:wrap;gap:8px;margin-top:9px}
  .mwt-next-more a{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:999px;border:1.5px solid #c7d2fe;background:#fff;color:#4338ca!important;font-size:.88rem;font-weight:600;text-decoration:none!important}
  .mwt-next-more a:hover{border-color:#818cf8;background:#eef2ff}
  .mwt-next .mwt-next-sr{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;white-space:nowrap!important;border:0!important}
  .mwt-next .mwt-next-ic{display:inline-flex!important;flex:none;width:13px;height:13px;opacity:.75;color:inherit!important;background:none!important}
  .mwt-next .mwt-next-ic svg,.mwt-next .mwt-next-go svg{width:100%;height:100%}
  .mwt-next .mwt-next-go svg{width:17px;height:17px}
  @media (max-width:600px){a.mwt-next-main{padding:13px 12px 13px 14px}.mwt-next-t{font-size:1rem}}
</style>
<script>
(function () {
  var cfgEl = document.getElementById('mwt-next-config');
  if (!cfgEl) return;
  var CFG;
  try { CFG = JSON.parse(cfgEl.textContent || '{}'); } catch (e) { return; }
  if (!CFG || !((CFG.rules && CFG.rules.length) || (CFG.fb && CFG.fb.length))) return;
  CFG.rules = CFG.rules || [];
  CFG.ui = CFG.ui || {};
  if (navigator.webdriver || /bot|crawl|spider|slurp|headless|lighthouse|pagespeed/i.test(navigator.userAgent)) return;
  var LS = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
  var SS = function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} };
  var DAY = String(Math.floor(Date.now() / 86400000));
  var rendered = false;

  function area() { return document; }
  function formArea() { return document.getElementById('c1') || document; }
  function q(sel, root) { try { return (root || area()).querySelector(sel); } catch (e) { return null; } }
  function text(el) { return el ? (('value' in el && el.tagName !== 'DIV') ? el.value : el.textContent) || '' : ''; }
  function srcText() {
    var el = CFG.src ? q(CFG.src) : null;
    if (!el) el = q('textarea', formArea());
    return text(el);
  }
  function numbers(t) {
    var out = [], m = String(t || '').match(/-?\d+(?:[.,]\d+)?(?:e-?\d+)?/gi) || [];
    for (var i = 0; i < m.length; i++) { var v = parseFloat(m[i].replace(',', '.')); if (isFinite(v)) out.push(v); }
    return out;
  }
  function lines(t) {
    return String(t || '').split(/\r?\n/).map(function (s) { return s.trim(); }).filter(Boolean);
  }
  function words(t) { return String(t || '').trim().split(/\s+/).filter(Boolean); }
  function serverResult() {
    var c = document.getElementById('mwt-analytics-config');
    var r = document.getElementById('calculatorresult');
    return !!(c && c.dataset.serverResult === '1' && c.dataset.serverError !== '1' && r && r.getClientRects().length);
  }
  function visible(el) { return !!(el && el.getClientRects().length); }
  var clientRun = false;
  function resultEl() {
    if (CFG.watch) { var w = q(CFG.watch); if (visible(w)) return w; }
    var cr = document.getElementById('calculatorresult');
    if (clientRun && visible(cr)) return cr;
    return serverResult() ? cr : null;
  }
  var EN_STOP = /\b(the|and|of|to|is|in|that|for|with|you|it|on|are|this|was|as|be|have|not)\b/gi;
  var D = {
    result: function () { return resultEl() ? {} : null; },
    dims: function () {
      var vals = [], els = area().querySelectorAll('.ar-dim-value');
      for (var i = 0; i < els.length; i++) { var n = parseInt(String(els[i].textContent).replace(/[^\d]/g, ''), 10); if (n > 0) vals.push(n); }
      if (vals.length < 2) return null;
      var w = vals[vals.length - 2], h = vals[vals.length - 1];
      return (w >= 16 && h >= 16 && w <= 20000 && h <= 20000) ? { w: w, h: h } : null;
    },
    size_mb: function () {
      var v = parseFloat(text(q('[name=file_size]'))), u = String(text(q('[name=unit]'))).toLowerCase();
      if (!isFinite(v) || v <= 0) return null;
      var mult = { b: 1 / 1048576, byte: 1 / 1048576, bytes: 1 / 1048576, kb: 1 / 1024, kib: 1 / 1024, mb: 1, mib: 1, gb: 1024, gib: 1024 }[u];
      if (mult === undefined) return null;
      var mb = v * mult, kb = mb * 1024;
      if (!(mb >= 0.02 && mb <= 200)) return null;
      var okKb = kb >= 5 && kb <= 50000;
      return { size: v + ' ' + u.toUpperCase(), mb: mb >= 1 && mb <= 4000 ? String(Math.round(mb * 2) / 2) : '',
               kb: okKb ? String(Math.round(kb)) : '', kbmode: okKb ? 'custom' : '' };
    },
    numbers_list: function (rule) {
      var ns = numbers(srcText());
      if (ns.length < (rule.min || 5)) return null;
      return { n: ns.length, data: ns.join(', '), pairs: ns.slice(0, 200).map(function (v, i) { return (i + 1) + ',' + v; }).join('\n') };
    },
    kcal: function () {
      var cards = area().querySelectorAll('.wlc-strategy-card'), found = [];
      for (var i = 0; i < cards.length; i++) {
        var v = cards[i].querySelector('.wlc-det-value');
        var n = parseInt(String(text(v)).replace(/[^\d]/g, ''), 10);
        if (n >= 800 && n <= 6000) found.push(n);
      }
      if (!found.length) return null;
      var pick = { '250': 0, '500': 1, '750': 2 }[String(text(q('[name=deficit_mode]')))];
      if (pick === undefined && found.length >= 3) pick = Math.floor(found.length / 2);
      var n2 = found[pick !== undefined && pick < found.length ? pick : 0];
      var fmt;
      try { fmt = n2.toLocaleString(document.documentElement.lang || 'en'); } catch (e) { fmt = String(n2); }
      return { kcal: n2, kcal_fmt: fmt };
    },
    jump: function () {
      var n = parseFloat(String(text(q('.jump-value'))).replace(/[^\d.]/g, ''));
      return (n > 0 && n < 80) ? { jump: Math.round(n * 10) / 10 } : null;
    },
    names_list: function (rule) {
      var ls = lines(srcText());
      if (ls.length < (rule.min || 8)) return null;
      var ok = 0;
      for (var i = 0; i < ls.length; i++) if (ls[i].length <= 40 && /[A-Za-zÀ-ɏЀ-ӿ぀-ヿ一-鿿가-힯]/.test(ls[i]) && !/\d{3,}/.test(ls[i])) ok++;
      return ok >= ls.length * 0.8 ? { n: ls.length, names: ls.join('\n') } : null;
    },
    handles_list: function (rule) {
      var ls = lines(srcText());
      if (ls.length < (rule.min || 20)) return null;
      var ok = 0;
      for (var i = 0; i < ls.length; i++) if (/^@?[\w.]{3,30}$/.test(ls[i]) && (/^@/.test(ls[i]) || /[\d_.]/.test(ls[i]))) ok++;
      return ok >= ls.length * 0.6 ? { n: ls.length } : null;
    },
    word_mode: function () {
      var w = String(text(q('[name=word]'))).trim();
      if (!/[A-Za-z]{3,}/.test(w) || /^\d+$/.test(w)) return null;
      var clean = w.replace(/[^A-Za-z0-9]/g, '').toLowerCase();
      return clean.length >= 3 ? { word: clean, WORD: w.replace(/\s+/g, ' ').toUpperCase() } : null;
    },
    prompt: function () {
      var p = String(text(q('.wpg-prompt-text'))).trim();
      return p.length >= 20 ? { prompt: p } : null;
    },
    password_like: function () {
      var mode = q('[name=mode]:checked');
      if (mode && /verify|compare|check/i.test(mode.value)) return null;
      var t = String(text(q('[name=text]'))).trim();
      if (!t || /\s/.test(t) || t.length < 6 || t.length > 40) return null;
      if (/^[0-9a-f]+$/i.test(t) && [32, 40, 56, 64, 96, 128].indexOf(t.length) >= 0) return null;
      if (/^(https?:\/\/|www\.)/i.test(t) || /@.+\./.test(t)) return null;
      return /[A-Za-z]/.test(t) ? { text: t } : null;
    },
    non_english: function () {
      var t = srcText(), letters = t.match(/\p{L}/gu) || [];
      if (letters.length < 20) return null;
      var ascii = 0;
      for (var i = 0; i < letters.length; i++) if (/[A-Za-z]/.test(letters[i])) ascii++;
      var ws = words(t), stops = (t.match(EN_STOP) || []).length;
      if (1 - ascii / letters.length >= 0.3) return { text: t };
      if (ws.length >= 40 && stops / ws.length < 0.02) return { text: t };
      return null;
    },
    long_text: function (rule) {
      var t = srcText(), n = words(t).length;
      var cjk = (t.match(/[぀-ヿ㐀-鿿가-힯฀-๿]/g) || []).length;
      if (cjk > n) n = Math.round(cjk / 2);
      return n >= (rule.min || 300) ? { text: t, n: n } : null;
    },
    has_emails: function (rule) {
      var m = srcText().match(/[\w.+-]+@[\w-]+\.[\w.-]+/g) || [];
      var uniq = {}; for (var i = 0; i < m.length; i++) uniq[m[i].toLowerCase()] = 1;
      var n = Object.keys(uniq).length;
      return n >= (rule.min || 3) ? { n: n, text: srcText() } : null;
    },
    low_punct: function () {
      var t = srcText(), ws = words(t);
      if (ws.length < 60) return null;
      var stops = (t.match(EN_STOP) || []).length;
      if (stops / ws.length < 0.04) return null;
      var marks = (t.match(/[.!?]/g) || []).length;
      return (marks * 100 / ws.length) < 3 ? { text: t } : null;
    },
    signs3: function () {
      var els = area().querySelectorAll('.summary-sign'), v = [];
      for (var i = 0; i < els.length && v.length < 3; i++) { var t = String(els[i].textContent || '').trim(); if (t) v.push(t); }
      return v.length === 3 ? { sun: v[0], moon: v[1], rising: v[2] } : null;
    },
    sun_md: function () {
      var m = parseInt(text(q('[name=birth_month]', formArea())), 10), d = parseInt(text(q('[name=birth_day]', formArea())), 10);
      if (!(m >= 1 && m <= 12 && d >= 1 && d <= 31)) return null;
      var md = m * 100 + d, cuts = [[120, 'capricorn'], [219, 'aquarius'], [321, 'pisces'], [420, 'aries'], [521, 'taurus'], [621, 'gemini'],
        [723, 'cancer'], [823, 'leo'], [923, 'virgo'], [1023, 'libra'], [1122, 'scorpio'], [1222, 'sagittarius'], [1232, 'capricorn']];
      for (var i = 0; i < cuts.length; i++) if (md < cuts[i][0]) return { sun: cuts[i][1] };
      return null;
    },
    moon_glyph: function () {
      var g = String(text(q('.moon-symbol-large')) || '').replace(/︎|️/g, '').trim();
      var keys = ['aries', 'taurus', 'gemini', 'cancer', 'leo', 'virgo', 'libra', 'scorpio', 'sagittarius', 'capricorn', 'aquarius', 'pisces'];
      var i = '♈♉♊♋♌♍♎♏♐♑♒♓'.indexOf(g.charAt(0));
      return i >= 0 ? { moon: keys[i] } : null;
    },
    fields: function (rule) {
      var out = {}, read = rule.read || {};
      for (var k in read) {
        if (!Object.prototype.hasOwnProperty.call(read, k)) continue;
        var v = String(text(q(read[k], formArea())) || '').trim();
        var nm = !v && String(read[k]).match(/^\[name=["']?([\w-]+)["']?\]$/);
        if (nm) { try { v = String(new URLSearchParams(location.search).get(nm[1]) || '').trim(); } catch (e) {} }
        if (/date$/.test(k) && v) {
          var m = v.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/) || v.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
          if (!m) v = '';
          else if (m[1].length === 4) v = m[1] + '-' + ('0' + m[2]).slice(-2) + '-' + ('0' + m[3]).slice(-2);
          else v = m[3] + '-' + ('0' + m[1]).slice(-2) + '-' + ('0' + m[2]).slice(-2);
        }
        if (/time$/.test(k) && v) {
          var tm = v.match(/^(\d{1,2}):(\d{2})(?::\d{2})?\s*([ap]\.?m\.?)?$/i);
          if (!tm) v = '';
          else {
            var hh = parseInt(tm[1], 10);
            if (tm[3]) { var pm = /^p/i.test(tm[3]); hh = (hh % 12) + (pm ? 12 : 0); }
            v = ('0' + hh).slice(-2) + ':' + tm[2];
          }
        }
        out[k] = v;
      }
      var need = rule.need || [];
      for (var i = 0; i < need.length; i++) if (!out[need[i]]) return null;
      return out;
    },
    two_texts: function (rule) {
      var tas = formArea().querySelectorAll('textarea');
      if (tas.length < 2) return null;
      var a = words(tas[0].value).length, b = words(tas[1].value).length;
      if (!(a >= (rule.min || 80) && b >= (rule.min || 80))) return null;
      return { text: (a >= b ? tas[0] : tas[1]).value };
    },
    words_field: function (rule) {
      if (!resultEl()) return null;
      var raw = String(text(q(rule.field || 'textarea', formArea())) || '');
      var ws = raw.split(/[\r\n,;]+/).map(function (s) { return s.trim(); }).filter(function (s) { return s && s.length <= 40; });
      return ws.length >= (rule.min || 3) ? { n: ws.length, words: ws.join('\n') } : {};
    },
    equation: function () {
      var r = resultEl();
      if (!r) return null;
      var bits = [], cp = r.querySelectorAll('[data-copy],[data-clipboard-text],[data-eq]');
      for (var i = 0; i < cp.length; i++) bits.push(cp[i].getAttribute('data-copy') || cp[i].getAttribute('data-clipboard-text') || cp[i].getAttribute('data-eq') || '');
      var mm = r.querySelectorAll('math');
      for (var j = 0; j < mm.length; j++) bits.push(mm[j].textContent || '');
      bits.push(r.innerText || '');
      var all = bits.join('\n').replace(/−/g, '-').replace(/²/g, '^2').replace(/³/g, '^3').replace(/·|⋅|×/g, '*')
        .replace(/\\[dt]?frac\{([^{}]+)\}\{([^{}]+)\}/g, function (_, a, b) {
          var p = function (v) { v = v.trim(); return /^-?\d+(\.\d+)?$/.test(v) ? v : '(' + v + ')'; };
          return p(a) + '/' + p(b);
        }).replace(/\\(left|right)/g, '').replace(/\\cdot|\\times/g, '*');
      var re = /(?:^|[^A-Za-z])y\s*=\s*([-+]?[\dx(.][\dx\s.+\-*\/^()]*)/g, m;
      while ((m = re.exec(all))) {
        if (/^\s*\\[A-Za-z]/.test(all.slice(re.lastIndex, re.lastIndex + 12))) continue;
        var e = m[1].replace(/\s+/g, ' ').trim().replace(/[\s+\-*\/^(]+$/, '');
        if (!/x/.test(e) || /xx|x\d|\dx\d/.test(e.replace(/\s/g, ''))) continue;
        e = e.replace(/(\d|\))\s*(x|\()/g, '$1*$2').replace(/x\s*\(/g, 'x*(').replace(/\s+/g, ' ');
        if (e.length <= 120) return { fx: e };
      }
      return {};
    }
  };

  function fill(label, data) {
    return label.replace(/\{(\w+)\}/g, function (_, k) { return data[k] !== undefined ? String(data[k]) : ''; });
  }
  function walled(slug) { return LS('mwt_pw_' + slug) === DAY; }
  function evaluate() {
    var hits = [];
    for (var i = 0; i < CFG.rules.length && hits.length < (CFG.max || 2); i++) {
      var rule = CFG.rules[i], det = D[rule.when];
      if (!det || walled(rule.to)) continue;
      var data = null;
      try { data = det(rule); } catch (e) { data = null; }
      if (!data) continue;
      if (rule.read && rule.when !== 'fields') {
        var extra = D.fields({ read: rule.read }) || {};
        for (var ek in extra) if (extra[ek] && data[ek] === undefined) data[ek] = extra[ek];
      }
      hits.push({ rule: rule, data: data });
    }
    return hits;
  }
  function gtagSend(name, params) {
    if (typeof window.gtag !== 'function') return;
    try { window.gtag('event', name, params); } catch (e) {}
  }
  /* A related-tool link to a tool some task rule can prefill still carries
     what that rule would: the rule only missed on its threshold (three names
     are too few to be worth "split into teams", not too few to bring along). */
  function carryFor(to) {
    for (var i = 0; i < CFG.rules.length; i++) {
      var r = CFG.rules[i], det = D[r.when], data = null;
      if (r.to !== to || !r.carry || !det) continue;
      var loose = {};
      for (var k in r) if (Object.prototype.hasOwnProperty.call(r, k)) loose[k] = r[k];
      loose.min = 1; loose.need = [];
      try { data = det(loose); } catch (e) { data = null; }
      if (!data) continue;
      if (r.read && r.when !== 'fields') {
        var extra = D.fields({ read: r.read }) || {};
        for (var ek in extra) if (extra[ek] && data[ek] === undefined) data[ek] = extra[ek];
      }
