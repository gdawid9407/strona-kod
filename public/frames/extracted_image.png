      a.addEventListener('click', function () {
        try { handoff(hit); } catch (e) {}
        gtagSend('next_step_click', { source_tool: CFG.module, target_tool: hit.rule.to, rule: hit.rule.when, transport_type: 'beacon' });
      });
    }
    function srHint(hit, a) {
      if (hit.rule.secret || !CFG.ui.newtab) return;
      var sr = document.createElement('span'); sr.className = 'mwt-next-sr'; sr.textContent = ' ' + CFG.ui.newtab;
      a.appendChild(sr);
    }
    for (var i = 0; i < hits.length; i++) {
      var hit = hits[i], a = document.createElement('a'), label = fill(hit.rule.label, hit.data);
      wire(hit, a);
      if (i === 0) {
        a.className = 'mwt-next-main';
        var tx = document.createElement('span'); tx.className = 'mwt-next-txt';
        var t = document.createElement('span'); t.className = 'mwt-next-t'; t.textContent = label; tx.appendChild(t);
        if (hit.rule.tname) { var s = document.createElement('span'); s.className = 'mwt-next-s'; s.textContent = hit.rule.tname; tx.appendChild(s); }
        a.appendChild(tx);
