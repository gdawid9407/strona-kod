</script>





<script type="application/json" id="mwt-welcome-data">{"v": 1, "slug": "video-to-image-extractor", "emoji": "🎥", "title": "Video to Image Extractor", "benefit": "Pull single or multiple frames out of any video and save them as PNG, JPG, or WEBP images.", "steps": ["Select your video and choose Single Frame or Multiple Frames mode", "Set the time or interval, then click Extract Image(s)", "Download the frames individually or as a ZIP file"], "labels": {"eyebrow": "First time here? · 30-second guide", "cta_example": "Show me a live example", "cta_start": "Got it — let me try", "dont_show": "Don't show tips again", "footer": "Free · No sign-up · Works on any device", "close": "Close welcome guide"}}</script><script>
(function () {
  'use strict';
  if (navigator.webdriver ||
      /bot|crawler|spider|slurp|bingpreview|headless|lighthouse|google-|inspectiontool|ptst|gtmetrix/i.test(navigator.userAgent)) return;
  var isMobile = !!(window.matchMedia && window.matchMedia('(max-width: 993px)').matches);
  var el = document.getElementById('mwt-welcome-data');
  if (!el) return;
  var data;
  try { data = JSON.parse(el.textContent); } catch (e) { return; }
  if (!data || !data.slug || !data.labels || !data.steps) return;
  var L = data.labels;
  function track(name, extra) {
    try {
      if (typeof window.gtag !== 'function') return;
      var p = { tool: data.slug, device: isMobile ? 'mobile' : 'desktop' };
      if (extra) for (var k in extra) p[k] = extra[k];
      window.gtag('event', name, p);
    } catch (e) {}
  }

  var KEY = 'mwtWelcome1';
  var store;
  try { store = JSON.parse(window.localStorage.getItem(KEY) || '{}') || {}; }
  catch (e) { return; } 
  store.s = store.s || {};
  if (store.off || store.s[data.slug] || (store.c || 0) >= 3) return;
  if (Date.now() - (store.t || 0) < 86400000) return;
  function save() {
    try { window.localStorage.setItem(KEY, JSON.stringify(store)); } catch (e) {}
  }

  var CSS = [
    '.mwtw-backdrop{position:fixed;inset:0;z-index:2147483647;background:rgba(15,23,42,.45);display:flex;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;opacity:0;transition:opacity .2s ease}',
    '.mwtw-backdrop.mwtw-in{opacity:1}',
    '.mwtw-card{position:relative;background:#fff;width:100%;max-width:500px;border-radius:18px;box-shadow:0 24px 64px rgba(15,23,42,.22);padding:30px 28px;box-sizing:border-box;font-family:-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;color:#374151;max-height:calc(100vh - 40px);overflow-y:auto;opacity:0;transform:scale(.96);transition:opacity .22s cubic-bezier(.2,.8,.3,1),transform .22s cubic-bezier(.2,.8,.3,1)}',
    '.mwtw-backdrop.mwtw-in .mwtw-card{opacity:1;transform:none}',
    '.mwtw-coin{width:52px;height:52px;border-radius:50%;background:#f1f8e9;display:flex;align-items:center;justify-content:center;font-size:28px;margin-bottom:12px}',
    '.mwtw-eyebrow{margin:0;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#2e7d32}',
    '.mwtw-title{margin:6px 0 8px;font-size:25px;line-height:1.3;font-weight:700;color:#111827}',
    '.mwtw-benefit{margin:0;font-size:18px;line-height:1.55;color:#374151}',
    '.mwtw-steps{list-style:none;margin:18px 0;padding:0}',
    '.mwtw-steps li{display:flex;align-items:flex-start;gap:12px;margin:0 0 12px}',
    '.mwtw-num{width:30px;height:30px;border-radius:50%;background:#e8f5e9;color:#2e7d32;font-size:15px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}',
    '.mwtw-steptext{font-size:17px;line-height:1.5;color:#4b5563;min-width:0}',
    '.mwtw-cta{display:block;width:100%;padding:14px 18px;background:#43a047;color:#fff;font-size:19px;font-weight:600;border:0;border-radius:10px;cursor:pointer;font-family:inherit}',
    '.mwtw-cta:hover{background:#2e7d32}',
    '.mwtw-footer{margin:12px 0 0;font-size:14px;color:#9ca3af;text-align:center}',
    '.mwtw-dontshow{display:block;margin:8px auto 0;background:none;border:0;padding:4px 6px;font-size:14px;color:#9ca3af;cursor:pointer;font-family:inherit;text-decoration:underline dotted}',
    '.mwtw-close{position:absolute;top:12px;right:12px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;padding:0;background:none;border:0;border-radius:8px;color:#9ca3af;font-size:24px;line-height:1;cursor:pointer;font-family:inherit}',
    '.mwtw-card:focus{outline:none}',
    '.mwtw-close:hover{background:#f3f4f6;color:#6b7280}',
    '.mwtw-cta:focus-visible,.mwtw-close:focus-visible,.mwtw-dontshow:focus-visible{outline:2px solid #2e7d32;outline-offset:2px}',
    '@media (max-width:640px){.mwtw-backdrop{align-items:flex-end;padding:0}.mwtw-card{max-width:none;border-radius:20px 20px 0 0;padding:24px 22px calc(20px + env(safe-area-inset-bottom));max-height:85vh;transform:translateY(24px)}}',
    '@media (prefers-reduced-motion:reduce){.mwtw-backdrop,.mwtw-card{transition:none;transform:none}}'
  ].join('\n');

  var timer = null, cancelled = false;
  function cancel() { 
    cancelled = true;
    if (timer) clearTimeout(timer);
    unbind();
  }
  function onFocus(e) {
    var t = e.target && e.target.tagName;
    if (t === 'INPUT' || t === 'TEXTAREA' || t === 'SELECT') cancel();
  }
  function onSubmit() { cancel(); }
  function onClick(e) {
    var t = e.target;
    if (t && t.closest && t.closest('a,button')) cancel();
  }
  function onScroll() {
    if (window.scrollY > window.innerHeight * 0.5) cancel();
  }
  function bind() {
    document.addEventListener('focusin', onFocus, true);
    document.addEventListener('submit', onSubmit, true);
    document.addEventListener('click', onClick, true);
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  function unbind() {
    document.removeEventListener('focusin', onFocus, true);
    document.removeEventListener('submit', onSubmit, true);
    document.removeEventListener('click', onClick, true);
    window.removeEventListener('scroll', onScroll);
  }
  function arm() {
    if (cancelled) return;
    if (window.scrollY > window.innerHeight * 0.5) return;
    bind();
    timer = setTimeout(function () { unbind(); show(); }, isMobile ? 5000 : 1600);
  }
  function start() {
    if (document.hidden) {
      var onVis = function () {
        if (!document.hidden) {
          document.removeEventListener('visibilitychange', onVis);
          arm();
        }
      };
      document.addEventListener('visibilitychange', onVis);
    } else {
      arm();
    }
  }

  function findExample() {
    var links = document.getElementsByTagName('a');
    for (var i = 0; i < links.length; i++) {
      var a = links[i];
      if (!a.getAttribute('href')) continue;
      if (a.pathname !== window.location.pathname || !a.search) continue;
      if (a.href.indexOf('embedded=') !== -1) continue;
      if (a.closest && a.closest('#sharearea,nav,header,footer')) continue;
      return a.href;
    }
    return null;
  }

  function mk(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }

  function show() {
    if (document.getElementById('mwtw-backdrop')) return;

    store.s[data.slug] = 1;
    store.c = (store.c || 0) + 1;
    store.t = Date.now();
    save();
    track('welcome_show', { shown_total: store.c });

    var style = document.createElement('style');
    style.textContent = CSS;
    document.head.appendChild(style);

    var backdrop = mk('div', 'mwtw-backdrop');
    backdrop.id = 'mwtw-backdrop';
    var card = mk('div', 'mwtw-card');
    card.setAttribute('role', 'dialog');
    card.setAttribute('aria-modal', 'true');
    card.setAttribute('aria-labelledby', 'mwtw-title');
    card.setAttribute('tabindex', '-1');

    var closeBtn = mk('button', 'mwtw-close', '×');
    closeBtn.type = 'button';
    closeBtn.setAttribute('aria-label', L.close);
    card.appendChild(closeBtn);

    card.appendChild(mk('div', 'mwtw-coin', data.emoji || '✨'));
    card.appendChild(mk('p', 'mwtw-eyebrow', L.eyebrow));
    var title = mk('p', 'mwtw-title', data.title);
    title.id = 'mwtw-title';
    card.appendChild(title);
    card.appendChild(mk('p', 'mwtw-benefit', data.benefit));

    var ol = mk('ol', 'mwtw-steps');
    for (var i = 0; i < data.steps.length && i < 3; i++) {
      var li = document.createElement('li');
      li.appendChild(mk('span', 'mwtw-num', String(i + 1)));
      li.appendChild(mk('span', 'mwtw-steptext', data.steps[i]));
      ol.appendChild(li);
    }
    card.appendChild(ol);

    var exampleHref = findExample();
    var cta = mk('button', 'mwtw-cta', exampleHref ? L.cta_example : L.cta_start);
    cta.type = 'button';
    card.appendChild(cta);
    card.appendChild(mk('p', 'mwtw-footer', L.footer));
    var dontShow = mk('button', 'mwtw-dontshow', L.dont_show);
    dontShow.type = 'button';
    card.appendChild(dontShow);

    backdrop.appendChild(card);
    document.body.appendChild(backdrop);

    var prevFocus = document.activeElement;
    var prevOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';

    function close() {
      document.removeEventListener('keydown', onKey, true);
      if (backdrop.parentNode) backdrop.parentNode.removeChild(backdrop);
      if (style.parentNode) style.parentNode.removeChild(style);
      document.body.style.overflow = prevOverflow;
      if (prevFocus && prevFocus.focus) {
        try { prevFocus.focus({ preventScroll: true }); } catch (e) {}
      }
    }
    function onKey(e) {
      if (e.key === 'Escape') { track('welcome_close', { via: 'escape' }); close(); return; }
      if (e.key === 'Tab') { 
        var f = card.querySelectorAll('button');
        if (!f.length) return;
        var first = f[0], last = f[f.length - 1];
        var active = document.activeElement;
        if (!card.contains(active) || active.tagName !== 'BUTTON') {
          e.preventDefault(); (e.shiftKey ? last : first).focus();
        } else if (e.shiftKey && active === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault(); first.focus();
        }
      }
    }
    document.addEventListener('keydown', onKey, true);
    backdrop.addEventListener('click', function (e) {
      if (e.target === backdrop) { track('welcome_close', { via: 'backdrop' }); close(); }
    });
    closeBtn.addEventListener('click', function () { track('welcome_close'); close(); });
    dontShow.addEventListener('click', function () {
      store.off = 1;
      save();
      track('welcome_never');
      close();
    });
    cta.addEventListener('click', function () {
      track('welcome_cta', { has_example: exampleHref ? 1 : 0, transport_type: 'beacon' });
      if (exampleHref) { window.location.href = exampleHref; return; }
      close();
      var fields = document.querySelectorAll('input:not([type=hidden]), textarea, select');
      for (var i = 0; i < fields.length; i++) {
        var f = fields[i];
        if (f.disabled || !f.offsetParent) continue;
        try {
          f.scrollIntoView({ block: 'center' });
          f.focus({ preventScroll: true });
        } catch (e) { f.focus(); }
        break;
      }
    });

    card.focus({ preventScroll: true });
    setTimeout(function () { backdrop.className += ' mwtw-in'; }, 20);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script></body></html>
