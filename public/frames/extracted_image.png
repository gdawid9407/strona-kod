<script>

(function(){
  if (window.mwtUpsellModal) return;  
  var lastFocus = null;

  function closeModal(el){
    if (!el) return;
    el.classList.remove('on');
    setTimeout(function(){ if (el.parentNode) el.parentNode.removeChild(el); }, 200);
    document.removeEventListener('keydown', el._esc);
    if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch(e){} }
  }

  window.mwtUpsellModal = function(opts){
    opts = opts || {};
    if (window.mwtCloseToolbox) window.mwtCloseToolbox();
    lastFocus = document.activeElement;
    var backdrop = document.createElement('div');
    backdrop.className = 'mwt-modal-backdrop';
    backdrop.setAttribute('role','dialog');
    backdrop.setAttribute('aria-modal','true');
    backdrop.setAttribute('aria-labelledby','mwt-modal-title');
    backdrop.innerHTML =
      '<div class="mwt-modal">' +
        '<button class="mwt-modal-close" aria-label="Close">&times;</button>' +
        '<div class="mwt-modal-head">' +
          '<div class="mwt-modal-icon" aria-hidden="true">' + (opts.icon || '★') + '</div>' +
          '<h3 class="mwt-modal-title" id="mwt-modal-title"></h3>' +
        '</div>' +
        '<div class="mwt-modal-body"></div>' +
        '<div class="mwt-modal-foot">' +
          '<button type="button" class="mwt-modal-btn ghost" data-act="cancel"></button>' +
          '<a class="mwt-modal-btn primary" data-act="ok"></a>' +
        '</div>' +
      '</div>';
    document.body.appendChild(backdrop);
    backdrop.querySelector('#mwt-modal-title').textContent = opts.title || '';
    backdrop.querySelector('.mwt-modal-body').innerHTML = opts.message || '';
    var cancelBtn = backdrop.querySelector('[data-act="cancel"]');
    var okBtn     = backdrop.querySelector('[data-act="ok"]');
    cancelBtn.textContent = opts.cancelText || 'Maybe later';
    okBtn.textContent = opts.primaryText || 'Upgrade';
    okBtn.href = opts.primaryHref || '/premium-subscription/';
    if (opts.primaryTarget) okBtn.target = opts.primaryTarget;
    if (opts.onPrimary) okBtn.addEventListener('click', function(ev){ opts.onPrimary(ev); });

    function done(){ closeModal(backdrop); }
    cancelBtn.addEventListener('click', done);
    backdrop.querySelector('.mwt-modal-close').addEventListener('click', done);
    backdrop.addEventListener('click', function(e){ if (e.target === backdrop) done(); });
    backdrop._esc = function(e){ if (e.key === 'Escape') done(); };
    document.addEventListener('keydown', backdrop._esc);

    requestAnimationFrame(function(){ backdrop.classList.add('on'); });
    setTimeout(function(){ try { okBtn.focus(); } catch(e){} }, 60);
    return backdrop;
  };

  window.mwtToast = function(message, opts){
    opts = opts || {};
    var wrap = document.querySelector('.mwt-toast-wrap');
    if (!wrap){
      wrap = document.createElement('div');
      wrap.className = 'mwt-toast-wrap';
      document.body.appendChild(wrap);
    }
    var t = document.createElement('div');
    t.className = 'mwt-toast';
    t.setAttribute('role','status');
    t.innerHTML = (opts.tick !== false ? '<span class="tick">✓</span>' : '') + message;
    wrap.appendChild(t);
    requestAnimationFrame(function(){ t.classList.add('on'); });
    setTimeout(function(){
      t.classList.remove('on');
      setTimeout(function(){ if (t.parentNode) t.parentNode.removeChild(t); }, 220);
    }, opts.duration || 2400);
  };
})();

function updatelocal() {
    var mytoollistElem = document.getElementById("mytoollist");
    if (mytoollistElem) {
        localStorage.setItem("mytoollist", mytoollistElem.innerHTML);
    }
}

function initializeToolbox() {
    var text = localStorage.getItem("mytoollist");
    if (text !== null && text.toLowerCase().includes('miniwebtool')) {
        var mytoollistElem = document.getElementById("mytoollist");
        if (mytoollistElem) {
            mytoollistElem.innerHTML = text;
            var closetoolbox = document.getElementsByClassName("closetoolbox");
            for (var i = 0; i < closetoolbox.length; i++) {
                closetoolbox[i].onclick = function() {
                    var div = this.parentElement;
                    div.remove();
                    updatelocal();
                }
            }
        }
    }
}

function initializeAutomaticMode() {
initializeToolbox();
mwtToolboxBadge(); 
var automaticmode = getCookie("automaticmode");
var checkBox = document.getElementById("myonoffswitch");
checkBox.checked = automaticmode=="true";
 
if (automaticmode == "true"){
  document.getElementById("addtoolbox").style.display="none";
  newElement();
}

}



function newElement() {
  
  var i1 = document.getElementById("myUL").getElementsByTagName("li").length;
  if (i1>2) {
    mwtUpsellModal({
      icon: '★',
      title: "My Toolbox is full on Free",
      message: "Free accounts can keep <strong>3 favourites</strong> in My Toolbox. Upgrade to <strong>Pro</strong> or <strong>Premium</strong> to save as many as you like &mdash; plus Automatic Mode, which remembers every tool you use.",
      primaryText: "See plans",
      cancelText: "Not now",
      primaryHref: '/premium-subscription/?src=toolbox&from=_video_to_image_extractor_'
    });
    var cb = document.getElementById("myonoffswitch");
    if (cb) cb.checked = false;
    setCookie('automaticmode', false, 365);
    return;
  }
  
  var inputValue = '<a href="https://MiniWebtool.com/video-to-image-extractor/">Video to Image Extractor</a>';
  var ulcontent = document.getElementById("myUL").innerHTML;
  if (!ulcontent.toLowerCase().includes(inputValue.toLowerCase())){
  var li = document.createElement("li");
  li.innerHTML=inputValue;
  
    document.getElementById("myUL").appendChild(li);
  
  

  var span = document.createElement("SPAN");
  var txt = document.createTextNode("\u00D7");
  span.className = "closetoolbox";
  span.title = "Remove the link";
  span.appendChild(txt);
  li.appendChild(span);
  var closetoolbox = document.getElementsByClassName("closetoolbox");
  var i;

  for (i = 0; i < closetoolbox.length; i++) {
    closetoolbox[i].onclick = function() {
      var div = this.parentElement;
      div.remove();
      updatelocal();
    }
  }
  updatelocal();
}
else{
  if (!document.getElementById("myonoffswitch").checked){
    mwtToast("Video to Image Extractor is already in your toolbox");
  }
}
}



function mytoolboxcheck() {



  var checkBox = document.getElementById("myonoffswitch");

  
    mwtUpsellModal({
      icon: '⚡',
      title: "Automatic Mode is a paid feature",
      message: "With <strong>Automatic Mode</strong>, every tool you use is silently added to My Toolbox &mdash; so it's already waiting the next time you need it. It's unlocked for <strong>Pro</strong> and <strong>Premium</strong> subscribers.",
      primaryText: "See plans",
      cancelText: "Not now",
      primaryHref: '/premium-subscription/?src=automode&from=_video_to_image_extractor_'
    });
    checkBox.checked = false;
    setCookie('automaticmode', false, 365);
    return;
  

  var text = document.getElementById("addtoolbox");
  if (checkBox.checked == true){
    text.style.display = "none";
    checkBox.checked = true;
    
  } else {
     text.style.display = "block";
     checkBox.checked = false;
  }
  setCookie('automaticmode',checkBox.checked,365);
  updatelocal();
}
function mwtToolboxBadge() {
  var list = document.getElementById("mytoollist");
  var badge = document.getElementById("mwt-tb-count");
  if (!list || !badge) return;
  var n = list.getElementsByTagName("li").length;
  badge.textContent = n;
  if (n > 0) { badge.classList.remove("w3-hide"); } else { badge.classList.add("w3-hide"); }
  var empty = document.getElementById("mwt-tb-empty");
  if (empty) {
    if (n > 0) { empty.classList.add("w3-hide"); } else { empty.classList.remove("w3-hide"); }
  }
}

(function () {
  function watch() {
    var list = document.getElementById("mytoollist");
    if (!list) return;
    mwtToolboxBadge();
    if (window.MutationObserver) {
      new MutationObserver(mwtToolboxBadge).observe(list, { childList: true, subtree: true });
    }
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", watch);
  } else {
    watch();
  }
})();

(function () {
  function closeToolbox() {
    var panel = document.getElementById("mytoolbox");
    if (!panel || panel.className.indexOf("w3-show") === -1) return;
    panel.className = panel.className.replace(" w3-show", "").replace("w3-show", "");
    var trigger = document.querySelector(".mwt-tb-trigger");
    if (trigger) trigger.className = trigger.className.replace("activelinkto", "linkto");
  }
  window.mwtCloseToolbox = closeToolbox;
  document.addEventListener("click", function (e) {
    var wrap = document.querySelector(".mwt-tb-wrap");
    if (wrap && !wrap.contains(e.target)) closeToolbox();
  }, true);
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" || e.key === "Esc") closeToolbox();
  });
})();
