<script>
(function () {
  function setOpen(open) {
    var p = document.getElementById('mwt-rel-panel');
    if (!p) { return; }
    p.classList.toggle('show', open);
    var b = document.getElementById('mwt-rel-btn');
    if (b) { b.setAttribute('aria-expanded', open ? 'true' : 'false'); }
  }
  window.mwtToggleRelated = function () {
    var p = document.getElementById('mwt-rel-panel');
    if (p) { setOpen(!p.classList.contains('show')); }
  };
  document.addEventListener('click', function (e) {
    var p = document.getElementById('mwt-rel-panel');
    if (!p || !p.classList.contains('show')) { return; }
    if (e.target.closest && (e.target.closest('#mwt-rel-panel') || e.target.closest('#mwt-rel-btn'))) { return; }
    setOpen(false);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { setOpen(false); }
  });
})();
</script>

<script>
(function () {
  try {
    var d = navigator.userAgentData, u = navigator.userAgent || "";
    var chromium = (d && d.brands && d.brands.length)
      ? d.brands.some(function (b) { return b.brand === "Chromium"; })
      : (/Chrome\/|Chromium\//.test(u) && !/Firefox|FxiOS/.test(u));
    if (!chromium) { document.documentElement.className += " mwt-no-cws"; }
  } catch (e) {}
})();
</script>
<style>html.mwt-no-cws .mwt-ext-link { display: none !important; }</style>

<style>#firsttitle .mwt-since { font-weight: 600; }
@media (max-width: 1200px) { #firsttitle .mwt-tagline-stat { display: none; } }</style>

<style>.mwt-since-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 999px;
  background: #EDE9FE;
  border: 1px solid #DDD6FE;
  color: #4C1D95;
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}
.mwt-since-badge svg { width: 13px; height: 13px; flex-shrink: 0; }
body.darkpagetheme .mwt-since-badge { background: #312E81; border-color: #4338CA; color: #E0E7FF; }
@media (max-width: 993px) { #firsttitle { display: flex; align-items: center; justify-content: flex-end; gap: 10px; } }
@media (max-width: 359px) { .mwt-since-badge { display: none; } }</style>

<style>@media (max-width: 993px) {
  div.mwt-tool-trust.mwt-tool-trust-limited { flex-wrap: wrap !important; }
  div.mwt-tool-trust.mwt-tool-trust-limited .mwt-tool-trust-item:nth-child(1) { display: inline-flex; white-space: normal; }
  div.mwt-tool-trust.mwt-tool-trust-limited.mwt-tool-trust-dated .mwt-tool-trust-item:nth-child(2) { display: none; }
}</style>
<script id="mwt-ts-guard">
(function(){
var nativeSubmit=HTMLFormElement.prototype.submit;
function tok(f){var i=f.querySelector('input[name="cf-turnstile-response"]');return i?i.value:''}
function needs(f){return f&&f.querySelector&&!f.__mwtGate&&!f.__mwtTsPass&&f.querySelector('.cf-turnstile')&&!tok(f)}
function hold(f,go){
  if(f.__mwtTsWait)return;
  f.__mwtTsWait=true;f.classList.add('mwt-ts-wait');
  var w=f.querySelector('.cf-turnstile'),n=0;
  var iv=setInterval(function(){
    n++;
    var ready=!!tok(f),dead=(!window.turnstile&&n>20)||(n>40&&!(w&&w.offsetHeight));
    if(!ready&&!dead&&n<400)return;
    clearInterval(iv);f.__mwtTsWait=false;f.classList.remove('mwt-ts-wait');
    f.__mwtTsPass=true;
    try{go()}finally{f.__mwtTsPass=false}
  },150);
}
window.addEventListener('submit',function(e){
  var f=e.target;
  if(e.defaultPrevented||!needs(f))return;
  e.preventDefault();
  var sub=e.submitter&&e.submitter.form===f?e.submitter:null;
  hold(f,function(){try{if(f.requestSubmit){sub?f.requestSubmit(sub):f.requestSubmit()}else{nativeSubmit.call(f)}}catch(x){nativeSubmit.call(f)}});
});
HTMLFormElement.prototype.submit=function(){
  var f=this;
  if(!needs(f))return nativeSubmit.call(f);
  hold(f,function(){nativeSubmit.call(f)});
};
})();
</script>
<style id="mwt-ts-guard-css">form.mwt-ts-wait [type="submit"]{opacity:.7;cursor:progress}</style>
<script id="mwt-ts-overlay">
(function(){
function waiting(){var fs=document.querySelectorAll('form'),out=[];for(var i=0;i<fs.length;i++){var f=fs[i],w=f.querySelector('.cf-turnstile');if(!w)continue;var t=w.querySelector('input[name="cf-turnstile-response"]');if(t&&t.value)continue;if(f.classList.contains('mwt-ts-wait')||f.querySelector('.mwt-gate-wait'))out.push(w)}return out}
function watch(lo){
  if(lo.__mwtTsIv)return;
  var n=0,lifted=false;
  lo.__mwtTsIv=setInterval(function(){
    n++;
    var ws=waiting();
    if(!lifted&&ws.length&&lo.classList.contains('active')){lifted=true;lo.classList.remove('active');try{ws[0].scrollIntoView({block:'center',behavior:'smooth'})}catch(x){}}
    else if(lifted&&!ws.length){lo.classList.add('active');stop()}
    else if(!lifted&&(n>20||!lo.classList.contains('active')))stop();
    else if(n>450){lo.classList.remove('active');stop()}
  },150);
  function stop(){clearInterval(lo.__mwtTsIv);lo.__mwtTsIv=null}
}
function arm(){var lo=document.getElementById('mwt-loading');if(!lo||lo.__mwtTsArm)return;lo.__mwtTsArm=1;new MutationObserver(function(){if(lo.classList.contains('active'))watch(lo)}).observe(lo,{attributes:true,attributeFilter:['class']})}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm();
})();
</script>
<script id="mwt-ts-pass">
(function(){
function passed(){return /(?:^|;\s*)mwt_tsok=/.test(document.cookie)}
window.mwtTsPassed=passed;
function off(w){if(w.__mwtOff)return;w.__mwtOff=1;w.classList.remove('cf-turnstile');w.classList.add('cf-turnstile-passed');w.innerHTML='<input type="hidden" name="cf-turnstile-response" value="mwt-tsok">'}
function safe(){var t=window.turnstile;if(!t||t.__mwtSafe)return;t.__mwtSafe=1;['reset','render','remove','execute','getResponse'].forEach(function(k){var f=t[k];if(typeof f==='function')t[k]=function(){try{return f.apply(t,arguments)}catch(e){}}})}
function scan(){if(!passed())return;document.documentElement.classList.add('mwt-tsok');var ws=document.querySelectorAll('.cf-turnstile');for(var i=0;i<ws.length;i++)off(ws[i]);safe()}
if(passed()){scan();new MutationObserver(scan).observe(document.documentElement,{childList:true,subtree:true})}
var n=0,iv=setInterval(function(){scan();if(++n>1800)clearInterval(iv)},1000);
})();
</script>
<style id="mwt-ux-fix-v1">
.main mjx-container[display="true"] { max-width: 100%; overflow-x: auto; overflow-y: hidden; }
.mwt-hscroll { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
#c1 .mwt-field-invalid { border-color: #dc2626 !important; box-shadow: 0 0 0 3px rgba(220, 38, 38, .18) !important; }
#c1 label.mwt-field-invalid { border-radius: 6px; }
#c1 .mwt-cg-dark.mwt-cg-dark, #c1 .mwt-cg-dark.mwt-cg-dark *, #re1 .mwt-cg-dark.mwt-cg-dark, #re1 .mwt-cg-dark.mwt-cg-dark *, .main .mwt-cg-dark.mwt-cg-dark, .main .mwt-cg-dark.mwt-cg-dark * { color: #1f2937 !important; -webkit-text-fill-color: #1f2937 !important; text-shadow: none !important; }
#c1 .mwt-cg-muted.mwt-cg-muted, #c1 .mwt-cg-muted.mwt-cg-muted *, #re1 .mwt-cg-muted.mwt-cg-muted, #re1 .mwt-cg-muted.mwt-cg-muted *, .main .mwt-cg-muted.mwt-cg-muted, .main .mwt-cg-muted.mwt-cg-muted * { color: #475569 !important; -webkit-text-fill-color: #475569 !important; }
#c1 .mwt-cg-shadow.mwt-cg-shadow, #re1 .mwt-cg-shadow.mwt-cg-shadow, .main .mwt-cg-shadow.mwt-cg-shadow { text-shadow: 0 1px 2px rgba(0, 0, 0, .45), 0 0 1px rgba(0, 0, 0, .35) !important; }
</style>
<script id="mwt-ux-fix-v1-js">
(function () {
  function scrollsX(el) {
    for (var a = el; a && a !== document.body; a = a.parentElement) {
      if (a.id === 'c1') continue;
      var ox = getComputedStyle(a).overflowX;
      if (ox === 'auto' || ox === 'scroll') return true;
    }
    return false;
  }
  function wrapWide() {
    var main = document.querySelector('.main');
    if (!main) return;
    var tables = main.querySelectorAll('table');
    for (var i = 0; i < tables.length; i++) {
      var t = tables[i], p = t.parentElement;
      if (!p || p.classList.contains('mwt-hscroll') || t.closest('.mwt-hscroll')) continue;
      if (t.getBoundingClientRect().width <= p.clientWidth + 2 || scrollsX(p)) continue;
      var w = document.createElement('div');
      w.className = 'mwt-hscroll';
      p.insertBefore(w, t);
      w.appendChild(t);
    }
  }
  function markInvalid() {
    var holder = document.querySelector('.mwt-err-fields');
    if (!holder) return;
    var names = (holder.getAttribute('data-fields') || '').split(/\s+/);
    names.forEach(function (n) {
      if (!n) return;
      var fields = document.querySelectorAll('#c1 [name="' + n.replace(/["\\]/g, '') + '"]');
      Array.prototype.forEach.call(fields, function (el) {
        if (el.type === 'hidden') return;
        var box = (el.type === 'radio' || el.type === 'checkbox') ? (el.closest('label') || el.parentElement) : el;
        box.classList.add('mwt-field-invalid');
        el.setAttribute('aria-invalid', 'true');
        var clear = function () {
          Array.prototype.forEach.call(document.querySelectorAll('#c1 [name="' + el.name + '"]'), function (x) {
            x.removeAttribute('aria-invalid');
            var b = (x.type === 'radio' || x.type === 'checkbox') ? (x.closest('label') || x.parentElement) : x;
            b.classList.remove('mwt-field-invalid');
          });
        };
        el.addEventListener('input', clear, { once: true });
        el.addEventListener('change', clear, { once: true });
      });
    });
  }
  var CG = ['mwt-cg-dark', 'mwt-cg-muted', 'mwt-cg-shadow'];
  var BTN = 'button, input[type=submit], input[type=button], a[class*=btn], [role=button]';
  function rgbs(s) {
    var out = [], re = /rgba?\(([^)]+)\)/g, m;
    while ((m = re.exec(s || ''))) {
      var p = m[1].split(/[ ,\/]+/).filter(Boolean).map(Number);
      out.push({ r: p[0], g: p[1], b: p[2], a: p.length > 3 ? p[3] : 1 });
    }
    return out;
  }
  function lum(c) {
    function f(v) { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }
    return 0.2126 * f(c.r) + 0.7152 * f(c.g) + 0.0722 * f(c.b);
  }
  function con(a, b) { var x = lum(a), y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); }
  function minCon(c, stops) { var m = 99; for (var i = 0; i < stops.length; i++) m = Math.min(m, con(c, stops[i])); return m; }
  function textHost(el) {
    if (el.tagName === 'INPUT') return el;
    var best = el, len = 0, tw = document.createTreeWalker(el, 4), n;
    while ((n = tw.nextNode())) { var s = n.nodeValue.trim(); if (s.length > len && n.parentElement) { len = s.length; best = n.parentElement; } }
    return len ? best : null;
  }
  function bgStops(host, btn) {
    for (var e = host; e && e.nodeType === 1; e = e.parentElement) {
      var cs = getComputedStyle(e);
      if (cs.backgroundImage && cs.backgroundImage.indexOf('url(') >= 0) return null;
      if (cs.backgroundImage && cs.backgroundImage.indexOf('gradient') >= 0) {
        var g = rgbs(cs.backgroundImage).filter(function (c) { return c.a > 0.2; });
        if (g.length) return g;
      }
      var c = rgbs(cs.backgroundColor)[0];
      if (c && c.a > 0.6) return [c];
      if (e === btn) return behind(btn);
    }
    return null;
  }
  var pending = window.IntersectionObserver ? new IntersectionObserver(function (entries) {
    entries.forEach(function (en) { if (en.isIntersecting) { pending.unobserve(en.target); try { guard(en.target); } catch (e) {} } });
  }) : null;
  function opaqueOf(e) {
    var cs = getComputedStyle(e);
    if (cs.backgroundImage && cs.backgroundImage.indexOf('url(') >= 0) return 'img';
    if (cs.backgroundImage && cs.backgroundImage.indexOf('gradient') >= 0) {
      var g = rgbs(cs.backgroundImage).filter(function (c) { return c.a > 0.2; });
      if (g.length) return g;
    }
    var c = rgbs(cs.backgroundColor)[0];
    return c && c.a > 0.6 ? [c] : null;
  }
  function behind(btn) {
    var r = btn.getBoundingClientRect(), x = r.left + r.width / 2, y = r.top + r.height / 2;
    if (y < 0 || y > innerHeight || x < 0 || x > innerWidth || !document.elementsFromPoint) {
      if (pending) pending.observe(btn);
      return null;
    }
    var stack = document.elementsFromPoint(x, y);
    for (var i = 0; i < stack.length; i++) {
      var e = stack[i];
      if (e === btn || btn.contains(e)) continue;
      var o = opaqueOf(e);
      if (o === 'img') return null;
      if (o) return o;
    }
    return [{ r: 255, g: 255, b: 255, a: 1 }];
  }
  var WHITE = { r: 255, g: 255, b: 255 }, DARK = { r: 31, g: 41, b: 55 }, MUTED = { r: 71, g: 85, b: 105 };
  function decide(el) {
    var r = el.getBoundingClientRect();
    if (r.width < 1 || r.height < 1) return null;
    var host = textHost(el);
    if (!host) return null;
    var fg = rgbs(getComputedStyle(host).color)[0], stops = bgStops(host, el);
    if (!fg || !stops || fg.a < 0.2) return null;
    if (minCon(fg, stops) >= 3) return null;
    var cw = minCon(WHITE, stops), cd = minCon(DARK, stops), cm = minCon(MUTED, stops);
    if (lum(fg) > 0.6) return (cw >= 2.3 || cw >= cd) ? 'mwt-cg-shadow' : 'mwt-cg-dark';
    return cm >= 4.5 ? 'mwt-cg-muted' : 'mwt-cg-dark';
  }
  function guard(el) {
    var host = textHost(el) || el, nodes = host === el ? [el] : [el, host], saved = [];
    nodes.forEach(function (n) { saved.push(n.style.transition); n.style.transition = 'none'; });
    var had = CG.filter(function (c) { return el.classList.contains(c); });
    had.forEach(function (c) { el.classList.remove(c); });
    var want = null;
    try { want = decide(el); } finally {
      if (want) el.classList.add(want);
      void el.offsetWidth;
      nodes.forEach(function (n, i) { n.style.transition = saved[i]; });
    }
  }
  function guardAll() {
    var main = document.querySelector('.main');
    if (!main) return;
    var els = main.querySelectorAll(BTN);
    for (var i = 0; i < els.length; i++) { try { guard(els[i]); } catch (e) {} }
  }
  function guardLater(el) {
    var b = el && el.closest && el.closest(BTN);
    if (b && b.closest('.main')) requestAnimationFrame(function () { try { guard(b); } catch (e) {} });
  }
  var timer = null, gtimer = null;
  function soon() { clearTimeout(timer); timer = setTimeout(wrapWide, 250); clearTimeout(gtimer); gtimer = setTimeout(guardAll, 300); }
  function init() {
    markInvalid();
    wrapWide();
    guardAll();
    var main = document.querySelector('.main');
    var strip = function (s) { return (s || '').replace(/\bmwt-cg-\w+\b/g, '').trim().split(/\s+/).sort().join(' '); };
    if (main && window.MutationObserver) new MutationObserver(function (recs) {
      for (var i = 0; i < recs.length; i++) {
        var rec = recs[i];
        if (rec.type === 'attributes' && rec.attributeName === 'class' && strip(rec.oldValue) === strip(rec.target.getAttribute('class'))) continue;
        soon();
        return;
      }
    }).observe(main, { childList: true, subtree: true, attributes: true, attributeOldValue: true, attributeFilter: ['class', 'aria-pressed', 'aria-selected', 'disabled'] });
    window.addEventListener('resize', soon);
    ['pointerover', 'pointerout', 'focusin', 'focusout'].forEach(function (t) { document.addEventListener(t, function (e) { guardLater(e.target); }, true); });
    document.addEventListener('click', function () { clearTimeout(gtimer); gtimer = setTimeout(guardAll, 120); }, true);
    window.addEventListener('load', guardAll);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>

<style id="mwt-featured-badge-tip-style">.mwt-featured-tool h1.print.mwt-featured-badge-ready::after{content:none}.mwt-featured-badge{display:inline-block;position:relative;vertical-align:middle;background:gold;color:#111;padding:2px 8px;border-radius:3px;font-size:.5em;line-height:1.4;margin-left:10px;white-space:nowrap;font-weight:600;cursor:help}.mwt-featured-badge:focus{outline:2px solid #1d4ed8;outline-offset:3px}.mwt-featured-tip{position:absolute;z-index:1000;top:calc(100% + 9px);left:50%;transform:translate(-50%,-3px);width:max-content;max-width:min(320px,80vw);padding:7px 10px;border-radius:6px;background:#111;color:#fff;font-size:.85rem;font-weight:500;line-height:1.35;letter-spacing:0;white-space:normal;box-shadow:0 4px 14px rgba(0,0,0,.28);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .15s ease,transform .15s ease}.mwt-featured-tip::before{content:"";position:absolute;bottom:100%;left:50%;transform:translateX(-50%);border:6px solid transparent;border-bottom-color:#111}.mwt-featured-badge:hover .mwt-featured-tip,.mwt-featured-badge:focus .mwt-featured-tip{opacity:1;visibility:visible;transform:translate(-50%,0)}@media (prefers-reduced-motion:reduce){.mwt-featured-tip{transition:none}}</style><script id="mwt-featured-badge-tip-script">(function(){function initFeaturedBadge(){var scope=document.querySelector(".mwt-featured-tool")||document;var heading=scope.querySelector("h1.print");if(!heading||heading.querySelector(".mwt-featured-badge")){return;}var label="Popular";var tipText="Top 200 of 1,930 Tools";var badge=document.createElement("span");var tip=document.createElement("span");badge.className="mwt-featured-badge";badge.tabIndex=0;badge.appendChild(document.createTextNode(label));tip.className="mwt-featured-tip";tip.id="mwt-featured-tip";tip.setAttribute("role","tooltip");tip.textContent=tipText;badge.setAttribute("aria-describedby",tip.id);badge.appendChild(tip);heading.classList.add("mwt-featured-badge-ready");heading.appendChild(badge);}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",initFeaturedBadge);}else{initFeaturedBadge();}})();</script></head> <body itemscope itemtype="http://schema.org/WebPage"> <div id="dSpace"></div> <div id="topbar"> <div id="firstbar" class="w3-row flex-container w3-white w3-padding"> <div class="w3-quarter w3-white" style="padding-top:.5em;"><a href="/" id=i1n aria-label="MiniWebtool.com"></a></div> <div id="firsttitle" class="w3-right "> <div class="w3-bar w3-white"> <div class="w3-margin-top w3-margin-right w3-wide desktoponly no-wrap"><span class="mwt-since">Since 2010</span><span class="mwt-tagline-stat"> &middot; Powering 2M+ tool runs every month</span></div> </div> <span class="mwt-since-badge mobileonly"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0 1 12 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 0 1 3.498 1.307 4.491 4.491 0 0 1 1.307 3.497A4.49 4.49 0 0 1 21.75 12a4.49 4.49 0 0 1-1.549 3.397 4.491 4.491 0 0 1-1.307 3.497 4.491 4.491 0 0 1-3.497 1.307A4.49 4.49 0 0 1 12 21.75a4.49 4.49 0 0 1-3.397-1.549 4.49 4.49 0 0 1-3.498-1.306 4.491 4.491 0 0 1-1.307-3.498A4.49 4.49 0 0 1 2.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 0 1 1.307-3.497 4.49 4.49 0 0 1 3.497-1.307Zm7.007 6.387a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg>Since 2010</span> </div> </div> <div id="secondbar" class="flex-container w3-black w3-padding"> <div id="navbutton" class="flex-left w3-black desktoponly"> <div class="w3-dropdown-hover w3-black">
