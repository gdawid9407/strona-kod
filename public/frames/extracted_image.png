  }
  function firstBlock(parent, skipSmall) {
    var kids = parent.children;
    for (var i = 0; i < kids.length; i++) {
      var k = kids[i];
      if (/^(SCRIPT|STYLE|TEMPLATE|LINK)$/.test(k.tagName) || !visible(k)) continue;
      if (skipSmall && (/^H[1-6]$/.test(k.tagName) || k.getBoundingClientRect().height < 60)) continue;
      return k;
    }
    return null;
  }
  function render(hits) {
    if (rendered || !hits.length) return;
    var at = mountPoint();
    if (!at || !at.parentNode) return;
    rendered = true;
    var isFb = !!hits[0].rule.fb;
    var box = document.createElement('div');
    box.id = 'mwt-next';
    box.className = 'mwt-next';
    box.setAttribute('role', 'navigation');
    if (isFb) box.setAttribute('data-fb', '1');
    var k = document.createElement('div');
    var lead = isFb ? '' : CFG.lead;
    k.className = 'mwt-next-k' + (lead ? ' lead' : '');
    k.textContent = lead || (isFb && CFG.ui.fbk && CFG.ui.fbk[hits[0].rule.g]) ||
      String((CFG.ui && CFG.ui.next) || 'Next').replace(/[:：]\s*$/, '');
    box.appendChild(k);
    var more = null, targets = [];
    /* New tab, so the result the visitor has not finished reading stays put
       (many results are no-store POSTs that Back cannot restore). Rules that
       carry a secret stay in this tab: the password travels in
       sessionStorage, which a noopener tab does not inherit. */
    var ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
    var NEWTAB = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>';
    function wire(hit, a) {
      a.href = hit.rule.url;
      a.setAttribute('data-to', hit.rule.to);
