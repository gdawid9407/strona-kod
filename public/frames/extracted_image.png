<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I get a still image out of a video?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Upload the video, select Single Frame, then click on the video's progress bar or drag the slider until the preview shows the moment you want. Choose PNG, JPG or WEBP and click Extract Image(s), then download the image."
      }
    },
    {
      "@type": "Question",
      "name": "How do I extract many frames at once?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Choose Multiple Frames and enter the interval in seconds, for example 2 for an image every two seconds. The interval must be shorter than the video. Single images are free; downloading all frames as a ZIP is a member feature."
      }
    },
    {
      "@type": "Question",
      "name": "Which image format should I choose?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PNG is lossless, so it is the right choice for frames containing text, screen recordings, line art or anything you will edit further. JPG is lossy and much smaller, which suits photographic frames destined for the web. WEBP gives roughly JPG-sized files at better quality and is supported by all modern browsers."
      }
    },
    {
      "@type": "Question",
      "name": "What resolution will the extracted images be?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Each frame comes out at the video's native resolution. A 1080p video yields 1920 by 1080 pixel images and a 4K video yields 3840 by 2160. The tool does not upscale, so an image cannot be sharper than the source video."
      }
    },
    {
      "@type": "Question",
      "name": "Why does the extracted frame look blurry or blocky?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Video compression allocates fewer bits to fast-moving frames, so a still pulled from a moving shot can show motion blur and compression artefacts that are invisible during playback. Picking a moment where the camera and subject are still gives a much cleaner image."
      }
    },
    {
      "@type": "Question",
      "name": "Is my video uploaded to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Extraction runs through FFmpeg compiled to WebAssembly inside your browser tab, so the video stays on your own device."
      }
    },
    {
      "@type": "Question",
      "name": "How many frames can I extract at once?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "There is no fixed cap, but every image is held in browser memory before it is zipped. A short interval on a long, high-resolution video produces thousands of large images and will exhaust the tab. Increase the interval or split the video first if that happens."
      }
    },
    {
      "@type": "Question",
      "name": "Can I extract frames at an exact frame number rather than a time?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Divide the frame number by the video's frame rate to get the timestamp and seek there, then use the Frame buttons under the preview to step one frame at a time and Capture this frame to save exactly what is on screen, at full resolution. Every capture and extraction from the same video counts as one run."
      }
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Extract Frames from a Video as Images",
  "description": "Capture a single frame at an exact timestamp, or a whole series at a fixed interval, and save them as PNG, JPG or WEBP files in your browser.",
  "totalTime": "PT3M",
  "supply": [{"@type": "HowToSupply", "name": "A video file in MP4, WEBM, MOV or AVI format"}],
  "tool": [{"@type": "HowToTool", "name": "Web browser with WebAssembly support"}, {"@type": "HowToTool", "name": "miniwebtool Video to Image Extractor"}],
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Wait for the engine to load",
      "text": "Open the Video to Image Extractor and let FFmpeg.wasm finish loading in your browser."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Upload your video",
      "text": "Drag and drop the file onto the upload area or click Select Video. The clip is read locally and never uploaded."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Choose single-frame or multi-frame extraction",
      "text": "Pick Single Frame to capture one exact moment, or Multiple Frames to capture an image at a fixed interval through the whole video."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Set the time or the interval",
      "text": "For a single frame, click on the video's progress bar or use the slider to land on the exact timestamp you want. For multiple frames, enter the gap in seconds between captures, for example 5 for one image every five seconds."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Choose the image format",
      "text": "Select PNG for lossless quality, JPG for small files, or WEBP for a modern balance of the two."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "name": "Extract and download",
      "text": "Click Extract Image(s), then download a single image directly or download every frame at once as a ZIP file."
    }
  ]
}
</script>
