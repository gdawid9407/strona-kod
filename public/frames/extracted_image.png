    return { rule: { to: r.to, slug: r.slug, url: r.url, when: 'related_' + r.g, g: r.g, fb: 1, paid: r.paid,
                     label: r.tname, tname: lead ? r.brief : '',
                     carry: c ? c.rule.carry : null, secret: c ? c.rule.secret : 0 },
             data: c ? c.data : {} };
  }
  function fallbackHits() {
    var out = [], fb = CFG.fb || [];
