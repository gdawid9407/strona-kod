  <script>
(function () {
  if (window.mwtRequestUsageStatus) return;
  var pending = Object.create(null);
  // Share only in-flight reads. Never reuse settled quota data after a
  // reserve/commit/refund, and never cache a user's quota in shared storage.
  window.mwtRequestUsageStatus = function (module, lang) {
    var url = '/_api/usage/status/?module=' + encodeURIComponent(module) +
      '&lang=' + encodeURIComponent(lang || 'en');
    var tv = (location.search || '').match(/[?&]tv=([ab])(?:&|$)/);
    if (tv) url += '&tv=' + tv[1];
    if (!pending[url]) {
      var request = Promise.resolve().then(function () {
        return fetch(url, {credentials: 'same-origin', cache: 'no-store'});
      }).then(function (response) { return response.ok ? response.json() : null; });
      pending[url] = request;
      function release() { if (pending[url] === request) delete pending[url]; }
      request.then(release, release);
    }
    return pending[url];
  };
})();
</script>

  <script>
  (function () {
    window.__mwtQuota = {
      module:    "_video_to_image_extractor_",
      lang:      "en",
      tier:      "free",
      limit:     3,
      used:      0,
      remaining: 3,
      blocked:   false,
      live:      false
    };

    if (!window.MwtUsage) {
      var ENDPOINT = "/_api/usage/consume/";
      // Forward a ?tv=a|b QA override from the page URL to the usage API so the
      // injected paywall fragment lands in the same experiment arm as the page.
      var MWT_TV_QS = (function () { var m = location.search.match(/[?&]tv=([a-z0-9_]{1,12})(?:&|$)/); return m ? '?tv=' + m[1] : ''; })();
      function uuid() {
        return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
          var r = crypto.getRandomValues(new Uint8Array(1))[0] % 16;
          var v = c === "x" ? r : (r & 0x3) | 0x8;
          return v.toString(16);
        });
      }
      async function call(action, module, runToken) {
        var response;
        var lang = (window.__mwtQuota && window.__mwtQuota.lang) || "en";
        try {
          response = await fetch(ENDPOINT + MWT_TV_QS, {
            method: "POST",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ module: module, lang: lang, run_token: runToken, action: action }),
          });
        } catch (e) {
          return { status: 0, json: { ok: false, reason: "network" } };
        }
        var data = {};
        try { data = await response.json(); } catch (e) { data = {}; }
        return { status: response.status, json: data };
      }
      window.MwtUsage = {
        newRunToken: uuid,
        reserve: function (mod, tok) { return call("reserve", mod, tok); },
        commit:  function (mod, tok) { return call("commit",  mod, tok); },
        refund:  function (mod, tok) { return call("refund",  mod, tok); },
      };
    }

    function mountNode() { return document.getElementById('mwt-usage-mount'); }

    function syncQuotaFromResponse(data) {
      var q = window.__mwtQuota;
      if (!q || !data) return;
      if (typeof data.used      !== 'undefined') q.used      = data.used;
      if (typeof data.remaining !== 'undefined') q.remaining = data.remaining;
      if (typeof data.limit     !== 'undefined') q.limit     = data.limit;
      if (typeof data.blocked   !== 'undefined') q.blocked   = !!data.blocked;
      if (typeof data.tier      !== 'undefined') q.tier      = data.tier;
      if (data.reward_capped) rqRetired = true;
      q.live = true;
    }

    window.updateMwtQuota = function (data) {
      if (!data) return;
      syncQuotaFromResponse(data);
      var mount = mountNode();
      if (mount && typeof data.html === 'string') {
        mount.innerHTML = data.html;
      }
      if (window.__mwtQuota.blocked) {
        disableMeteredButtons();
        firePaywallImpression('client');
        armRewardedForQuota();
        revealRewardBox();
      } else {
        enableMeteredButtons();
      }
    };

    window.showMwtPaywall = function (data) {
      window.updateMwtQuota(data);
      var pw = document.getElementById('mwt-paywall');
      if (pw) {
        try { pw.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) {}
      }
    };

    var AD_UNIT = "/71161633,21815091813/MINWBTOOL_miniwebtool/rewarded_ad";
    var AD_TEST = false;
    var rqSlot = null, rqReady = null, rqRequested = false;
    var rqBound = false, rqGranted = false, rqBtn = null;
    var rqRetired = false;

    function rqStubAd() {
      var left = 5;
      var o = document.createElement('div');
      o.style.cssText = 'position:fixed;inset:0;z-index:2147483647;background:#0f172a;color:#fff;' +
        'display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;' +
        'font:16px/1.5 system-ui,-apple-system,sans-serif;text-align:center;padding:24px';
      o.innerHTML = '<div style="font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;opacity:.55">' +
        'DEBUG rewarded-ad stub</div><div style="font-size:2.6rem;font-weight:800">' +
        '<span id="mwt-rq-stub-n">5</span></div>' +
        '<button type="button" id="mwt-rq-stub-x" style="border:0;border-radius:8px;padding:9px 18px;' +
        'font-size:.9rem;cursor:pointer">Close early (forfeit reward)</button>';
      document.body.appendChild(o);
      var timer = null;
      function finish(granted) {
        if (timer) { clearInterval(timer); timer = null; }
        if (o.parentNode) o.parentNode.removeChild(o);
        if (granted) onRqGranted();
        onRqClosed();
      }
      o.querySelector('#mwt-rq-stub-x').addEventListener('click', function () { finish(false); });
      timer = setInterval(function () {
        left -= 1;
        var n = o.querySelector('#mwt-rq-stub-n');
        if (n) n.textContent = String(left);
        if (left <= 0) finish(true);
      }, 1000);
    }

    function rewardBoxQ() { return document.getElementById('mwt-pw-reward'); }

    function armRewardedForQuota() {
      if (rqRetired || !AD_UNIT || rqRequested) return;
      if (!quota || !quota.module) return;
      rqRequested = true;
      if (AD_TEST) { onRqReady({ makeRewardedVisible: rqStubAd }); return; }
      try { if (typeof window.loadf === 'function') window.loadf(); } catch (e) {}
      window.googletag = window.googletag || {};
      window.googletag.cmd = window.googletag.cmd || [];
      googletag.cmd.push(function () {
        try {
          var fmt = googletag.enums && googletag.enums.OutOfPageFormat;
          if (!fmt || !fmt.REWARDED) return;
          rqSlot = googletag.defineOutOfPageSlot(AD_UNIT, fmt.REWARDED);
          if (!rqSlot) return;
          rqSlot.addService(googletag.pubads());
          if (!rqBound) {
            rqBound = true;
            googletag.pubads().addEventListener('rewardedSlotReady', onRqReady);
            googletag.pubads().addEventListener('rewardedSlotGranted', onRqGranted);
            googletag.pubads().addEventListener('rewardedSlotClosed', onRqClosed);
          }
          googletag.enableServices();
          googletag.display(rqSlot);
          googletag.pubads().refresh([rqSlot]);
        } catch (e) { rqRequested = false; }
      });
    }

    function showRewardNotice(kind) {
      var box = rewardBoxQ();
      if (!box) return;
      box.style.display = 'block';
      var b = document.getElementById('mwt-pw-reward-btn');
      var n = document.getElementById('mwt-pw-reward-note');
      if (b) b.style.display = 'none';
      if (n) n.style.display = 'none';
      var el = document.getElementById(kind === 'capped' ? 'mwt-pw-reward-capped' : 'mwt-pw-reward-error');
      if (el) el.style.display = 'block';
    }

    function revealRewardBox() {
      if (rqRetired || !rqReady) return;
      var box = rewardBoxQ();
      if (box) box.style.display = 'block';
    }

    function onRqReady(evt) {
      rqReady = evt;
      revealRewardBox();
      if (typeof gtag === 'function') {
        try { gtag('event', 'rewarded_offer_shown', { source_tool: quota.module, placement: 'quota' }); } catch (e) {}
      }
    }

    function onRqGranted() { rqGranted = true; }

    function onRqClosed() {
      try { googletag.destroySlots([rqSlot]); } catch (e) {}
      rqSlot = null; rqReady = null; rqRequested = false;
      var box = rewardBoxQ();
      if (box) box.style.display = 'none';
      if (!rqGranted) {
        if (rqBtn) { rqBtn.disabled = false; }
        if (typeof gtag === 'function') {
          try { gtag('event', 'rewarded_dismissed', { source_tool: quota.module, placement: 'quota' }); } catch (e) {}
        }
        return;
      }
      rqGranted = false;
      fetch('/_api/usage/reward/' + MWT_TV_QS, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ module: quota.module, lang: quota.lang || 'en' })
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.granted) {
            rqRetired = true;
            showRewardNotice(d && d.reason === 'capped' ? 'capped' : 'error');
            return;
          }
          if (typeof gtag === 'function') {
            try { gtag('event', 'rewarded_granted', { source_tool: quota.module, placement: 'quota' }); } catch (e) {}
          }
          window.updateMwtQuota(d);
        })
        .catch(function () { rqRetired = true; showRewardNotice('error'); });
    }

    window.mwtWatchAdForRun = function (btn) {
      if (!rqReady) return;
      rqBtn = btn || null;
      if (rqBtn) rqBtn.disabled = true;
      if (typeof gtag === 'function') {
        try { gtag('event', 'rewarded_opt_in', { source_tool: quota.module, placement: 'quota' }); } catch (e) {}
      }
      var evt = rqReady;
      rqReady = null;
      try { evt.makeRewardedVisible(); } catch (e) { if (rqBtn) rqBtn.disabled = false; }
    };

    var BTN_SELECTORS = [
      '#convert-btn', '#generate-btn', '#calculate-btn', '#process-btn',
      '#run-btn',     '#start-btn',    '#submit-btn',    '#split-btn',
      '#merge-btn',   '#compress-btn', '#extract-btn',
      '[data-mwt-meter]',
      "#extract\u002Dbtn, .vti\u002Dcapture",
    ].filter(Boolean).join(',');

    var quota = window.__mwtQuota;

    var ONCE_PER_INPUT = true;
    var charged = false;
    function meteringSuspended() { return ONCE_PER_INPUT && charged; }

    /* mwt-engine-gate: ffmpeg.wasm tools set window.MwtEngine.ready=false in
       createFFmpeg() and true once the core is loaded (mwt-ffmpeg-compat.js). */
    var lastRun = null, settleTimer = null, SETTLE_MS = 5000;

    function engineNotReady() {
      var e = window.MwtEngine;
      return !!(e && e.ready === false);
    }
    function engineWait(el) {
      el._mwtEW = true;
      el.disabled = true;
      el.setAttribute('data-mwt-engine-wait', '1');
    }
    function disableForEngine() {
      var btns = document.querySelectorAll(BTN_SELECTORS);
      for (var i = 0; i < btns.length; i++) {
        if (!btns[i].disabled) engineWait(btns[i]);
      }
    }
    function enableAfterEngine() {
      var btns = document.querySelectorAll('[data-mwt-engine-wait]');
      for (var i = 0; i < btns.length; i++) {
        btns[i].removeAttribute('data-mwt-engine-wait');
        if (!btns[i].getAttribute('data-mwt-blocked')) btns[i].disabled = false;
      }
    }
    function watchEngineButtons() {
      if (!window.MutationObserver) return;
      var mo = new MutationObserver(function (muts) {
        for (var i = 0; i < muts.length; i++) {
          var t = muts[i].target;
          if (!t || !t.matches || !t.matches(BTN_SELECTORS)) continue;
          if (t.disabled) {
            if (t._mwtEW) { t._mwtEW = false; }
            else { t.removeAttribute('data-mwt-engine-wait'); }
          } else if (engineNotReady()) {
            engineWait(t);
          }
        }
      });
      mo.observe(document.documentElement, { attributes: true, subtree: true, attributeFilter: ['disabled'] });
    }
    function finalizeRun(run) {
      if (!run || run.settled) return;
      run.settled = true;
      if (run.state === 'failed') {
        window.MwtUsage.refund(run.module, run.token).then(function (r) {
          if (!r || !r.json || !r.json.ok) return;
          charged = false;
          window.updateMwtQuota(r.json);
        });
      } else if (run.state === 'ok') {
        window.MwtUsage.commit(run.module, run.token);
      }
    }
    function flushSettle() {
      if (settleTimer) { clearTimeout(settleTimer); settleTimer = null; }
      finalizeRun(lastRun);
    }
    function settleRun(outcome) {
      if (!lastRun || lastRun.settled) return;
      lastRun.state = outcome;
      if (settleTimer) clearTimeout(settleTimer);
      settleTimer = setTimeout(function () { settleTimer = null; finalizeRun(lastRun); }, SETTLE_MS);
    }
    document.addEventListener('mwt:run-failed', function () { settleRun('failed'); });
    document.addEventListener('mwt:run-succeeded', function () { settleRun('ok'); });
    document.addEventListener('mwt:engine-loading', disableForEngine);
    document.addEventListener('mwt:engine-ready', enableAfterEngine);
    document.addEventListener('DOMContentLoaded', function () { if (engineNotReady()) disableForEngine(); });
    watchEngineButtons();

    function disableMeteredButtons() {
      if (meteringSuspended()) return;
      var btns = document.querySelectorAll(BTN_SELECTORS);
      for (var i = 0; i < btns.length; i++) {
        btns[i].disabled = true;
        btns[i].setAttribute('aria-disabled', 'true');
        btns[i].setAttribute('data-mwt-blocked', '1');
        btns[i].style.cursor = 'not-allowed';
        btns[i].style.opacity = '0.55';
      }
    }

    function enableMeteredButtons() {
      var btns = document.querySelectorAll(BTN_SELECTORS);
      for (var i = 0; i < btns.length; i++) {
        if (!btns[i].getAttribute('data-mwt-blocked')) continue;
        btns[i].disabled = false;
        btns[i].removeAttribute('aria-disabled');
        btns[i].removeAttribute('data-mwt-blocked');
        btns[i].style.cursor = '';
        btns[i].style.opacity = '';
      }
    }

    function applyBlockedStateIfNeeded() {
      if (quota.blocked || (quota.remaining != null && quota.remaining <= 0)) {
        disableMeteredButtons();
        armRewardedForQuota();
      }
    }

    function startNewInput() {
      charged = false;
      applyBlockedStateIfNeeded();
    }

    if (ONCE_PER_INPUT) {
      document.addEventListener('change', function (ev) {
        var t = ev.target;
        if (t && t.tagName === 'INPUT' && t.type === 'file') startNewInput();
      }, true);
      document.addEventListener('drop', startNewInput, true);
    }

    var _paywallFired = false;
    function _mwtTv() { var p = document.getElementById('mwt-paywall'); return p ? (p.getAttribute('data-mwt-exp') || '') : ''; }
    function firePaywallImpression(reason) {
      if (_paywallFired) return;
      if (typeof gtag !== 'function') return;
      _paywallFired = true;
      try {
        gtag('event', 'paywall_impression', {
          source_tool: quota.module || '',
          tier: quota.tier || 'free',
          used:  quota.used || 0,
          limit: quota.limit == null ? '' : quota.limit,
          reason: reason || 'server',
          exp_arm: _mwtTv()
        });
      } catch (e) {}
    }

    function hydrate() {
      if (!quota.module) return;
      window.mwtRequestUsageStatus(quota.module, quota.lang || 'en')
        .then(function (data) {
          if (!data) return;
          if (!data.metered || data.is_paid) {
            var mount = mountNode();
            if (mount) mount.innerHTML = '';
            syncQuotaFromResponse(data);
            return;
          }
          syncQuotaFromResponse(data);
          var mount = mountNode();
          if (mount && typeof data.html === 'string') {
            mount.innerHTML = data.html;
          }
          if (quota.blocked) {
            disableMeteredButtons();
            firePaywallImpression('client');
            armRewardedForQuota();
            revealRewardBox();
          }
        })
        .catch(function () {});
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        applyBlockedStateIfNeeded();
        hydrate();
      });
    } else {
      applyBlockedStateIfNeeded();
      hydrate();
    }

    if (quota.blocked || document.getElementById('mwt-paywall')) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function(){ firePaywallImpression('server'); });
      } else {
        firePaywallImpression('server');
      }
    }

    document.addEventListener('click', function (ev) {
      var cta = ev.target && ev.target.closest ? ev.target.closest('[data-mwt-upgrade-cta]') : null;
      if (!cta) return;
      if (typeof gtag !== 'function') return;
      try {
        var srcMatch = (cta.getAttribute('href') || '').match(/[?&]src=([a-z0-9_]+)/);
        gtag('event', 'begin_checkout', {
          source_tool: quota.module || '',
          tier: cta.getAttribute('data-mwt-upgrade-cta') || '',
          interval: cta.getAttribute('data-mwt-interval') || '',
          checkout_src: srcMatch ? srcMatch[1] : '',
          exp_arm: _mwtTv()
        });
      } catch (e) {}
    }, true);

    document.addEventListener('click', function (ev) {
      var btn = ev.target && ev.target.closest ? ev.target.closest(BTN_SELECTORS) : null;
      if (!btn) return;
      if (btn.hasAttribute('data-mwt-skip')) return;
      if (!quota.module) return;

      if (meteringSuspended()) return;

      if (engineNotReady()) {
        ev.preventDefault();
        ev.stopImmediatePropagation();
        ev.stopPropagation();
        engineWait(btn);
        return;
      }

      if (quota.blocked || (quota.remaining != null && quota.remaining <= 0)) {
        ev.preventDefault();
        ev.stopImmediatePropagation();
        ev.stopPropagation();
        disableMeteredButtons();
        window.showMwtPaywall(quota);
        return;
      }

      if (btn.disabled) return;

      charged = true;

      if (quota.remaining != null) quota.remaining = Math.max(0, quota.remaining - 1);
      quota.used = (quota.used || 0) + 1;

      var token = window.MwtUsage.newRunToken();

      var form = btn.closest && btn.closest('form');
      if (form) {
        var hidden = form.querySelector('input[name="mwt_run_token"]');
        if (!hidden) {
          hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'mwt_run_token';
          form.appendChild(hidden);
        }
        hidden.value = token;
      }

      flushSettle();
      lastRun = { module: quota.module, token: token, state: null, settled: false };

      window.MwtUsage.reserve(quota.module, token).then(function (r) {
        if (!r || !r.json) return;
        if (r.json.blocked) {
          window.showMwtPaywall(r.json);
        } else {
          window.updateMwtQuota(r.json);
        }
      });
    }, true); 
  })();
  </script>


     <div class=ma20> </div><div id="c1" style="overflow: auto;border-radius: 8px; "> <div class="miniwebtoolh" style="visibility: visible; opacity: 1; display: block; margin: 0px; padding: 16px 0px; text-align: center; font-family: arial; font-size: 20px; color: rgb(255, 255, 255); background: linear-gradient(135deg, #4a90e2, #6a5acd); position: relative; margin-bottom: 16px;">Video to Image Extractor<span class="tool-tryit">Try it now &mdash; free ▼</span></div>
<style>
.vti-frame-tools { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 12px 0 6px; }
.vti-step, .vti-capture { border: 0; border-radius: 999px; padding: 8px 14px; font-weight: 700; cursor: pointer; font-size: 14px; }
.vti-step { background: #EEF2FF; color: #3730A3; }
.vti-step:hover { background: #E0E7FF; color: #3730A3; }
.vti-capture { background: #F97316; color: #fff; }
.vti-capture:hover { background: #EA580C; color: #fff; }
.vti-frame-hint { text-align: center; font-size: 13px; color: #64748b; margin: 4px 0 10px; }
.vti-captures { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; margin-top: 10px; }
.vti-cap { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; }
.vti-cap img { display: block; width: 100%; height: auto; }
.vti-cap-meta { display: flex; justify-content: space-between; align-items: center; gap: 6px; padding: 6px 8px; font-size: 12px; color: #475569; }
.vti-cap-dl { font-weight: 700; color: #EA580C; }
</style>

<div id="converter-container">
    <div class="progress-container installation-progress" id="loading-container">
        <div class="progress-label">
            <span>Loading Extractor Engine (FFmpeg)</span>
            <span class="progress-percentage" id="loading-percentage">0%</span>
        </div>
        <div class="progress-bar">
            <div class="progress" id="loading-progress"></div>
        </div>
        <div class="status-message" id="loading-status">Initializing...</div>
    </div>

    <div class="upload-container hidden" id="drop-area">
        <p>Drag & drop your Video file here or</p>
        <label class="upload-btn" for="file-input">Select Video</label>
        <input type="file" id="file-input" class="file-input" accept="video/*">
        <div class="file-info hidden" id="file-info"></div>
    </div>

    <div class="preview-container hidden" id="preview-container">
        <div class="video-preview">
            <div class="preview-title">Original Video</div>
            <video id="video-preview" controls></video>
            <div id="video-details" class="file-info"></div>
            <div class="vti-frame-tools">
                <button type="button" class="vti-step" onclick="vtiStep(-1)" title="Back 1 second">&minus;1 s</button>
                <button type="button" class="vti-step" onclick="vtiStep(-1 / 30)" title="Previous frame">&#9664; Frame</button>
                <button type="button" class="vti-capture" data-mwt-meter onclick="vtiCapture()">&#128248; Capture this frame</button>
                <button type="button" class="vti-step" onclick="vtiStep(1 / 30)" title="Next frame">Frame &#9654;</button>
                <button type="button" class="vti-step" onclick="vtiStep(1)" title="Forward 1 second">+1 s</button>
            </div>
            <p class="vti-frame-hint">Pause on the moment you want, fine-tune with the frame buttons, then capture it at full resolution. Captures and extractions from the same video all count as one run.</p>
            <div class="vti-captures hidden" id="vti-captures"></div>
        </div>
    </div>

    <div class="controls hidden" id="controls">
        <div class="controls-title">Extraction Settings</div>

        <div class="control-group">
             <label>Extraction Mode</label>
             <div class="radio-group">
                 <div class="radio-option">
                     <input type="radio" id="mode-single" name="extract-mode" value="single" checked>
                     <label for="mode-single">Single Frame</label>
                 </div>
                 <div class="radio-option">
                     <input type="radio" id="mode-multiple" name="extract-mode" value="multiple">
                     <label for="mode-multiple">Multiple Frames (by Interval)</label>
                 </div>
             </div>
         </div>

         <div class="control-group" id="single-frame-controls">
             <label for="time-slider">Select Time (seconds)</label>
             <input type="range" id="time-slider" min="0" max="1" step="0.1" value="0">
              <div class="progress-label">
                  <span>Time:</span><span class="time-display" id="time-value">0.0s</span>
                  <input aria-label="Time input" type="number" id="time-input" class="inline-input" min="0" max="1" step="0.1" value="0">
              </div>
         </div>

         <div class="control-group hidden" id="multiple-frames-controls">
             <label for="interval-input">Extract Frame Every (seconds)</label>
             <input type="number" id="interval-input" min="0.1" step="0.1" value="5" placeholder="e.g., 5">
             <small class="form-text text-muted">Enter the interval in seconds (e.g., 1 for every second, 0.5 for every half second).</small>
         </div>

         <div class="control-group">
             <label for="format-select">Output Format</label>
             <select id="format-select">
                 <option value="png">PNG (Lossless)</option>
                 <option value="jpg">JPG (High Quality)</option>
                 <option value="webp">WEBP (Good Quality)</option>
             </select>
         </div>

        <button id="extract-btn" class="extract-btn" disabled>Extract Image(s)</button>

        <div class="progress-container conversion-progress hidden" id="conversion-progress-container">
            <div class="progress-label">
                <span>Extracting</span>
                <span class="progress-percentage" id="conversion-percentage">0%</span>
            </div>
            <div class="progress-bar">
                <div class="progress" id="conversion-progress"></div>
            </div>
            <div class="status-message" id="conversion-status">Processing...</div>
        </div>
    </div>

     <div class="image-output-container hidden" id="output-container">
         <div class="preview-title">Extracted Image(s)</div>
         <div class="single-image-preview" id="single-image-preview-area">
            <img id="single-image-preview" alt="Extracted image preview will appear here">
         </div>
         <div class="image-grid hidden" id="image-grid-area">
            <div class="image-grid-placeholder" id="image-grid-placeholder">Extraction results will appear here...</div>
         </div>
         <div id="output-info" class="output-info"></div>
         <a href="#" id="download-btn" class="download-btn hidden" download="extracted_image.png">Download Image</a>
         <button id="download-all-btn" class="download-btn hidden">Download All as ZIP</button>
         <button id="share-btn" class="share-btn hidden">Share Tool</button>
     </div>

</div>

<script>
    const loadingContainer = document.getElementById(`loading-container`);
    const loadingProgress = document.getElementById(`loading-progress`);
    const loadingPercentage = document.getElementById(`loading-percentage`);
    const loadingStatus = document.getElementById(`loading-status`);
    const dropArea = document.getElementById(`drop-area`);
    const fileInput = document.getElementById(`file-input`);
    const fileInfo = document.getElementById(`file-info`);
    const previewContainer = document.getElementById(`preview-container`);
    const videoPreview = document.getElementById(`video-preview`);
    const videoDetails = document.getElementById(`video-details`);
    const controlsContainer = document.getElementById(`controls`);
    const extractModeRadios = document.getElementsByName(`extract-mode`);
    const singleFrameControls = document.getElementById(`single-frame-controls`);
    const multipleFramesControls = document.getElementById(`multiple-frames-controls`);
    const timeSlider = document.getElementById(`time-slider`);
    const timeValue = document.getElementById(`time-value`);
    const timeInput = document.getElementById(`time-input`);
    const intervalInput = document.getElementById(`interval-input`);
    const formatSelect = document.getElementById(`format-select`);
    const extractBtn = document.getElementById(`extract-btn`);
    const conversionProgressContainer = document.getElementById(`conversion-progress-container`);
    const conversionProgress = document.getElementById(`conversion-progress`);
    const conversionPercentage = document.getElementById(`conversion-percentage`);
    const conversionStatus = document.getElementById(`conversion-status`);
    const outputContainer = document.getElementById(`output-container`);
    const singleImagePreviewArea = document.getElementById(`single-image-preview-area`);
    const singleImagePreview = document.getElementById(`single-image-preview`);
    const imageGridArea = document.getElementById(`image-grid-area`);
    const imageGridPlaceholder = document.getElementById(`image-grid-placeholder`);
    const outputInfo = document.getElementById(`output-info`);
    const downloadBtn = document.getElementById(`download-btn`);
    const downloadAllBtn = document.getElementById(`download-all-btn`);
    const shareBtn = document.getElementById(`share-btn`);


    let videoFile = null;
    let videoDuration = 0;
    let ffmpeg = null;
    let outputBlobs = [];
    let outputFormat = `png`;
    let zipFileName = `extracted_images.zip`;
    let singleImageUrl = null;
    let isSeeking = false;
    let sliderDragging = false;

    const { createFFmpeg, fetchFile } = FFmpeg;
    if (typeof JSZip === `undefined`) {
         
    }

    async function initializeFFmpeg() {
         if (typeof FFmpeg === `undefined` || !createFFmpeg) {
            showError(`Converter library failed to load. Please refresh.`);
            loadingProgress.style.backgroundColor = `#dc3545`; loadingProgress.style.width = `100%`; loadingPercentage.textContent = `Error.`; return;
         }
         try {
            loadingStatus.textContent = `Loading FFmpeg core...`; loadingProgress.style.width = `0%`; loadingPercentage.textContent = `0%`;
            ffmpeg = createFFmpeg({
                 log: true,
                 corePath: `https://images.miniwebtool.com/ffmpeg012/ffmpeg-core.js?v=20260922a`,
                 progress: ({ ratio }) => {
                     if (!conversionProgressContainer.classList.contains(`hidden`)) {
                        if (ratio >= 0 && ratio <= 1) {
                             const percentage = Math.round(ratio * 100);
                             conversionProgress.style.width = `${percentage}%`;
                             conversionPercentage.textContent = `${percentage}%`;
                             if (!conversionStatus.classList.contains(`error`)) {
                                 conversionStatus.textContent = `Processing... (${percentage}%)`;
                             }
                         } else if (!conversionStatus.classList.contains(`error`)) {
                             conversionStatus.textContent = `Processing... (Calculating)`;
                         }
                     }
                 },
             });
            let initProgress = 0;
            const initInterval = setInterval(() => {
                initProgress += 5;
                loadingProgress.style.width = `${Math.min(initProgress, 95)}%`;
                loadingPercentage.textContent = `${Math.min(initProgress, 95)}%`;
                if (initProgress >= 95) {
                    clearInterval(initInterval);
                    loadFFmpegCore();
                }
            }, 150);
         } catch (error) {
             showError(`Error initializing extractor engine: ${error.message}. Please refresh.`);
             loadingProgress.style.backgroundColor = `#dc3545`; loadingProgress.style.width = `100%`; loadingPercentage.textContent = `Error`;
         }
    }

    async function loadFFmpegCore() {
        try {
             await ffmpeg.load();
             loadingProgress.style.width = `100%`; loadingPercentage.textContent = `100%`; loadingStatus.textContent = `Extractor engine loaded successfully!`;
             setTimeout(() => {
                 loadingContainer.classList.add(`hidden`);
                 dropArea.classList.remove(`hidden`);
             }, 500);
         } catch(error) {
             showError(`Error loading extractor core: ${error.message}. Please refresh.`);
             loadingProgress.style.backgroundColor = `#dc3545`; loadingProgress.style.width = `100%`; loadingPercentage.textContent = `Error`;
         }
     }

    function handleFileSelect(event) {
        const file = event.target.files[0];
        if (file && file.type.startsWith(`video/`)) {
            processVideoFile(file);
        } else {
            showError(`Please select a valid video file.`);
            resetUI();
        }
    }

    function handleDrop(event) {
        const dt = event.dataTransfer;
        const file = dt.files[0];
        if (file && file.type.startsWith(`video/`)) {
            processVideoFile(file);
        } else {
            showError(`Please drop a valid video file.`);
            resetUI();
        }
    }

     function processVideoFile(file) {
        resetUI();
        videoFile = file;
        zipFileName = `${file.name.replace(/\.[^/.]+$/, ``)}_frames.zip`;
        fileInfo.textContent = `${file.name} (${formatFileSize(file.size)})`;
        fileInfo.classList.remove(`hidden`);

        const videoURL = URL.createObjectURL(file);
        videoPreview.src = videoURL;

        videoPreview.onloadedmetadata = function() {
            videoDuration = videoPreview.duration;
            if (isNaN(videoDuration) || videoDuration === Infinity || videoDuration <= 0) {
                showError(`Could not determine video duration or duration is invalid.`);
                resetUI();
                return;
            }
             previewContainer.classList.remove(`hidden`);
             controlsContainer.classList.remove(`hidden`);

            videoDetails.textContent = `Duration: ${formatTime(videoDuration)}`;
            const durationRounded = videoDuration.toFixed(1);
            timeSlider.max = durationRounded;
            timeInput.max = durationRounded;
            timeSlider.value = 0;
            timeInput.value = 0;
            timeValue.textContent = `0.0s`;
            extractBtn.disabled = false;
            shareBtn.classList.remove(`hidden`);

            videoPreview.removeEventListener(`timeupdate`, handleVideoTimeUpdate);
            videoPreview.removeEventListener(`seeked`, handleVideoTimeUpdate);
            videoPreview.removeEventListener(`seeking`, handleVideoSeeking);
            videoPreview.addEventListener(`timeupdate`, handleVideoTimeUpdate);
            videoPreview.addEventListener(`seeked`, handleVideoTimeUpdate);
            videoPreview.addEventListener(`seeking`, handleVideoSeeking);
        };

        videoPreview.onerror = function(e) {
            showError(`Error loading video preview.`);
            resetUI();
        };

    }

    function updateTime(source) {
        let value = 0;
        const singleModeActive = document.getElementById(`mode-single`).checked;

        if (source === `slider` || source === `input`) {
            value = (source === `slider`) ? parseFloat(timeSlider.value) : parseFloat(timeInput.value);
             if (isNaN(value)) value = 0;
             if (value < 0) value = 0;
             if (value > videoDuration) value = videoDuration;

             timeSlider.value = value;
             timeInput.value = value.toFixed(1);
             timeValue.textContent = `${value.toFixed(1)}s`;

            if (singleModeActive && videoPreview.readyState >= 1 && !isSeeking && !sliderDragging) {
                videoPreview.currentTime = value;
            }

        } else if (source === `video`) {
            value = videoPreview.currentTime;
             if (singleModeActive && !sliderDragging && !isSeeking) {
                 timeSlider.value = value;
                 timeInput.value = value.toFixed(1);
                 timeValue.textContent = `${value.toFixed(1)}s`;
             }
        }
    }

    function handleVideoTimeUpdate() {
        if (!sliderDragging) {
             updateTime(`video`);
        }
        isSeeking = false;
    }
    function handleVideoSeeking() {
        isSeeking = true;
    }

    timeSlider.addEventListener(`input`, () => {
        if (!sliderDragging) sliderDragging = true;
        updateTime(`slider`);
    });
    timeSlider.addEventListener(`change`, () => {
        sliderDragging = false;
        updateTime(`slider`);
    });
     timeInput.addEventListener(`change`, () => updateTime(`input`));


    extractModeRadios.forEach(radio => {
        radio.addEventListener(`change`, () => {
            resetOutput();
            if (radio.value === `single`) {
                singleFrameControls.classList.remove(`hidden`);
                multipleFramesControls.classList.add(`hidden`);
                 handleVideoTimeUpdate();
            } else {
                singleFrameControls.classList.add(`hidden`);
                multipleFramesControls.classList.remove(`hidden`);
            }
             outputInfo.textContent = ``;
        });
    });

    formatSelect.addEventListener(`change`, () => {
        outputFormat = formatSelect.value;
        resetOutput();
    });


     function resetUI() {
        videoFile = null;
        videoDuration = 0;

        videoPreview.removeEventListener(`timeupdate`, handleVideoTimeUpdate);
        videoPreview.removeEventListener(`seeked`, handleVideoTimeUpdate);
        videoPreview.removeEventListener(`seeking`, handleVideoSeeking);

        if (videoPreview.src) {
             URL.revokeObjectURL(videoPreview.src);
             videoPreview.removeAttribute(`src`);
        }
        videoPreview.load();

        fileInput.value = ``;
        fileInfo.classList.add(`hidden`);
        previewContainer.classList.add(`hidden`);
        controlsContainer.classList.add(`hidden`);
        extractBtn.disabled = true;
        videoDetails.textContent = ``;
        timeSlider.max = 1; timeSlider.value = 0;
        timeInput.max = 1; timeInput.value = 0;
        timeValue.textContent = `0.0s`;
        intervalInput.value = 5;
        formatSelect.value = `png`; outputFormat = `png`;
        document.getElementById(`mode-single`).checked = true;
        singleFrameControls.classList.remove(`hidden`);
        multipleFramesControls.classList.add(`hidden`);
        shareBtn.classList.add(`hidden`);
        resetOutput();
    }

    function resetOutput() {
        conversionProgressContainer.classList.add(`hidden`);
        outputContainer.classList.add(`hidden`);
        singleImagePreviewArea.classList.remove(`hidden`);
        if (singleImageUrl) {
            URL.revokeObjectURL(singleImageUrl);
            singleImageUrl = null;
        }
        singleImagePreview.src = ``;
        imageGridArea.classList.add(`hidden`);
        imageGridArea.innerHTML = ``;
        const placeholder = imageGridPlaceholder.cloneNode(true);
        placeholder.classList.remove(`hidden`);
        imageGridArea.appendChild(placeholder);
        outputInfo.textContent = ``;
        downloadBtn.classList.add(`hidden`);
        downloadAllBtn.classList.add(`hidden`);
        outputBlobs = [];
        conversionStatus.classList.remove(`error`);
        conversionStatus.textContent = ``;
    }

    function formatFileSize(bytes) {
        if (bytes === 0) return `0 Bytes`;
        const k = 1024; const sizes = [`Bytes`, `KB`, `MB`, `GB`, `TB`];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return `${parseFloat((bytes / Math.pow(k, i)).toFixed(2))} ${sizes[i]}`;
    }

    function formatTime(seconds) {
        const date = new Date(0);
        date.setSeconds(seconds);
        const isoTime = date.toISOString();
        const hhmmss = isoTime.substr(11, 8);
        const ms = isoTime.substr(20, 3);
        return `${hhmmss}.${ms}`;
     }

    function showError(message) {
        conversionStatus.textContent = `Error: ${message}`;
        conversionStatus.classList.add(`error`);
        conversionProgressContainer.classList.remove(`hidden`);
        conversionProgress.style.width = `100%`;
        conversionProgress.style.backgroundColor = `#dc3545`;
        conversionPercentage.textContent = `Error`;
     }

    function preventDefaults (e) { e.preventDefault(); e.stopPropagation(); }
    function highlight(e) { dropArea.classList.add(`drag-over`); }
    function unhighlight(e) { dropArea.classList.remove(`drag-over`); }
    [`dragenter`, `dragover`, `dragleave`, `drop`].forEach(eventName => {
        dropArea.addEventListener(eventName, preventDefaults, false);
        document.body.addEventListener(eventName, preventDefaults, false);
    });
    [`dragenter`, `dragover`].forEach(eventName => dropArea.addEventListener(eventName, highlight, false));
    [`dragleave`, `drop`].forEach(eventName => dropArea.addEventListener(eventName, unhighlight, false));
    dropArea.addEventListener(`drop`, handleDrop, false);
    fileInput.addEventListener(`change`, handleFileSelect);

    shareBtn.addEventListener(`click`, async () => {
        const shareData = {
            title: document.title,
            text: `Check out this Video to Image Extractor on miniwebtool.com!`,
            url: window.location.href
        };

        if (navigator.share) {
            try {
                await navigator.share(shareData);
            } catch (err) {
                 if (err.name !== `AbortError`) {
                     copyUrlFallback(`Web Share API failed. Link copied instead!`);
                 }
            }
        } else {
            copyUrlFallback(`Web Share not supported. Link copied to clipboard!`);
        }
    });

    function showStatusMessage(message, duration = 3000) {
        conversionStatus.classList.remove(`error`);
        conversionStatus.textContent = message;
        conversionProgressContainer.classList.remove(`hidden`);
        setTimeout(() => {
             if (conversionStatus.textContent === message) {
                conversionStatus.textContent = ``;
             }
        }, duration);
    }


    function copyUrlFallback(message) {
         navigator.clipboard.writeText(window.location.href).then(() => {
            showStatusMessage(message);
        }).catch(err => {
            showStatusMessage(`Sharing failed. Please copy the URL manually.`);
        });
    }


    extractBtn.addEventListener(`click`, async () => {
        if (!videoFile || !ffmpeg || !ffmpeg.isLoaded()) {
            showError(`Extractor not ready or no video file selected.`);
            return;
        }

        resetOutput();
        extractBtn.disabled = true;
        conversionProgressContainer.classList.remove(`hidden`);
        conversionProgress.style.width = `0%`;
        conversionProgress.style.backgroundColor = `#fd7e14`;
        conversionPercentage.textContent = `0%`;
        conversionStatus.textContent = `Preparing extraction...`;
        outputContainer.classList.remove(`hidden`);


        const mode = document.querySelector(`input[name="extract-mode"]:checked`).value;
        const format = formatSelect.value;
        const inputFilename = `input.${(videoFile.name.split(`.`).pop() || `mp4`)}`;
        let outputPattern = `output_%03d.${format}`;
        let singleOutputFilename = `output.${format}`;

        const cleanupFs = async (filenames) => {
             for (const name of filenames) {
                 try { await ffmpeg.FS(`unlink`, name); } catch (e) { }
             }
         };

        try {
            conversionStatus.textContent = `Loading video data into memory...`;
            let existingFiles = [];
            try { existingFiles = ffmpeg.FS(`readdir`, `/`); } catch (e) { }
             const filesToClean = existingFiles.filter(name => name.startsWith(`output.`) || name.startsWith(`output_`) || name === inputFilename );
             await cleanupFs(filesToClean);


            ffmpeg.FS(`writeFile`, inputFilename, await fetchFile(videoFile));
            conversionStatus.textContent = `Starting FFmpeg execution...`;

            let ffmpegCommand = [];

            if (mode === `single`) {
                singleImagePreviewArea.classList.remove(`hidden`);
                imageGridArea.classList.add(`hidden`);

                let seekTime = parseFloat(timeInput.value);
if (seekTime > videoDuration) {
    
            if (Math.abs(seekTime - videoDuration) < 0.1) { 
                seekTime = videoDuration;
            }
        }
                 if (isNaN(seekTime) || seekTime < 0 || seekTime > videoDuration) {
                     if (seekTime > videoDuration && Math.abs(seekTime - videoDuration) < 0.01) {
                        seekTime = videoDuration;
                        timeInput.value = seekTime.toFixed(1);
                     } else {
                        throw new Error(`Invalid time selected (${seekTime}s). Must be between 0 and ${videoDuration.toFixed(1)}s.`);
                     }
                 }

                 const endTimeThreshold = 0.01;
                 const seekAdjustDelta = 0.05;
                 let actualSeekTime = seekTime;
                 let displayTime = `${seekTime.toFixed(1)}s`;

                 if (seekTime >= videoDuration - endTimeThreshold && videoDuration > seekAdjustDelta) {
                     actualSeekTime = Math.max(0, videoDuration - seekAdjustDelta);
                     displayTime = `${seekTime.toFixed(1)}s (last frame)`;
                 }
                  timeValue.textContent = displayTime;

                ffmpegCommand = [
                    `-ss`, actualSeekTime.toString(),
                    `-i`, inputFilename,
                    `-vframes`, `1`,
                    `-q:v`, format === `jpg` ? `2` : `1`,
                    `-an`,
                    `-y`,
                ];
                if (format === `webp`) {
                    ffmpegCommand.push(`-c:v`, `libwebp`, `-lossless`, `0`, `-compression_level`, `6`, `-qscale:v`, `80`);
                }
                 ffmpegCommand.push(singleOutputFilename);

            } else {
                 singleImagePreviewArea.classList.add(`hidden`);
                 imageGridArea.classList.remove(`hidden`);
                 const currentPlaceholder = imageGridArea.querySelector(`.image-grid-placeholder`);
                 if(currentPlaceholder) currentPlaceholder.classList.add(`hidden`);

                const interval = parseFloat(intervalInput.value);
                if (isNaN(interval) || interval <= 0) {
                    throw new Error(`Invalid interval provided. Must be greater than 0.`);
                }
                 if (interval >= videoDuration) {
                    throw new Error(`Interval (${interval}s) must be shorter than the video duration (${videoDuration.toFixed(1)}s).`);
                 }

                 const fps = 1 / interval;

                 ffmpegCommand = [
                     `-i`, inputFilename,
                     `-vf`, `fps=${fps}`,
                     `-q:v`, format === `jpg` ? `2` : `1`,
                     `-an`,
                     `-y`,
                 ];
                if (format === `webp`) {
                     ffmpegCommand.push(`-c:v`, `libwebp`, `-lossless`, `0`, `-compression_level`, `6`, `-qscale:v`, `80`);
                }
                 ffmpegCommand.push(outputPattern);
            }

            await ffmpeg.run(...ffmpegCommand);

            conversionStatus.textContent = `Verifying output file(s)...`;
            let fileExists = false;
            if (mode === `single`) {
                 try {
                     const stats = ffmpeg.FS(`stat`, singleOutputFilename);
                     if (stats.size === 0) throw new Error(`Output file (${singleOutputFilename}) is empty.`);
                     fileExists = true;
                 } catch (e) {
                     throw new Error(`FFmpeg likely failed. Expected output file (${singleOutputFilename}) not found or empty. `);
                 }
            } else {
                 const firstExpectedFile = `output_001.${format}`;
                  try {
                     const stats = ffmpeg.FS(`stat`, firstExpectedFile);
                     if (stats.size === 0) throw new Error(`First output file (${firstExpectedFile}) is empty.`);
                     fileExists = true;
                 } catch (e) {
                     throw new Error(`FFmpeg likely failed. First expected file (${firstExpectedFile}) not found or empty. `);
                 }
            }

            conversionStatus.textContent = `Reading extracted image(s)...`;

            if (mode === `single` && fileExists) {
                const data = ffmpeg.FS(`readFile`, singleOutputFilename);
                const blob = new Blob([data.buffer], { type: `image/${format}` });
                singleImageUrl = URL.createObjectURL(blob);
                singleImagePreview.src = singleImageUrl;
                downloadBtn.href = singleImageUrl;
                const timeString = parseFloat(timeInput.value).toFixed(1).replace(`.`, `_`);
                downloadBtn.download = `${videoFile.name.replace(/\.[^/.]+$/, ``)}_${timeString}s.${format}`;
                downloadBtn.classList.remove(`hidden`);
                outputInfo.textContent = `Extracted 1 frame (${formatFileSize(blob.size)})`;

            } else if (mode === `multiple` && fileExists) {
                 let frameCount = 0;
                 let totalSize = 0;
                 outputBlobs = [];

                 for (let i = 1; ; i++) {
                     const filename = `output_${String(i).padStart(3, `0`)}.${format}`;
                     let fileData = null;

                     try {
                         const stats = ffmpeg.FS(`stat`, filename);
                         if (stats.size === 0) {
                             await cleanupFs([filename]);
                             break;
                         }

                         fileData = ffmpeg.FS(`readFile`, filename);

                         if (fileData && fileData.length > 0) {
                             const blob = new Blob([fileData.buffer], { type: `image/${format}` });
                             const imgUrl = URL.createObjectURL(blob);
                             const img = document.createElement(`img`);
                             img.src = imgUrl;
                             img.alt = `Frame ${i}`;
                             img.onload = () => {};
                             img.onerror = () => { URL.revokeObjectURL(imgUrl); };
                             imageGridArea.appendChild(img);
                             const friendlyFilename = `${videoFile.name.replace(/\.[^/.]+$/, ``)}_frame_${String(i).padStart(3, `0`)}.${format}`;
                             outputBlobs.push({ name: friendlyFilename, data: fileData.buffer });
                             frameCount++;
                             totalSize += fileData.length;
                         } else {
                            await cleanupFs([filename]);
                            continue;
                         }

                     } catch (e) {
                         break;
                     }

                      if (i > 2000) {
                        break;
                      }
                 }

                if (frameCount > 0) {
                    outputInfo.textContent = `Extracted ${frameCount} frames (${formatFileSize(totalSize)})`;
                    downloadAllBtn.classList.remove(`hidden`);
                } else {
                     outputInfo.textContent = `No valid frames extracted. Check interval or video content.`;
                     const currentPlaceholder = imageGridArea.querySelector(`.image-grid-placeholder`);
                     if(currentPlaceholder) currentPlaceholder.classList.remove(`hidden`);
                }
            }

            conversionStatus.textContent = `Extraction Complete!`;
            conversionProgress.style.width = `100%`;
            conversionPercentage.textContent = `100%`;

        } catch (error) {
            showError(`${(error && error.message) || (typeof error === `string` ? error : ``) || `Unknown extraction error occurred.`}`);
        } finally {
             extractBtn.disabled = false;
             if (!conversionStatus.classList.contains(`error`)) {
                conversionStatus.textContent += ` (Cleaning up FS...)`;
             }
             const filesToClean = [inputFilename, singleOutputFilename];
             const maxFramesToCheck = Math.max(5, outputBlobs.length + 5);
             for (let i=1; i < maxFramesToCheck; i++) {
                filesToClean.push(`output_${String(i).padStart(3, `0`)}.${format}`);
             }
             await cleanupFs(filesToClean);
        }
    });

    downloadAllBtn.addEventListener(`click`, async () => {
        if (!outputBlobs.length) {
            showError(`No images available to download.`);
            return;
        }
        if (typeof JSZip === `undefined`) {
            showError(`Could not create ZIP file. JSZip library missing.`);
            return;
        }

        downloadAllBtn.disabled = true;
        downloadAllBtn.textContent = `Zipping...`;
        showStatusMessage(`Creating ZIP file...`);

        try {
            const zip = new JSZip();
            outputBlobs.forEach(blobInfo => {
                zip.file(blobInfo.name, blobInfo.data);
            });

            const zipBlob = await zip.generateAsync({
                type: `blob`,
                compression: `DEFLATE`,
                compressionOptions: { level: 6 }
             }, (metadata) => {
                 showStatusMessage(`Zipping... ${metadata.percent.toFixed(0)}%`, 5000);
             });

            const zipUrl = URL.createObjectURL(zipBlob);
            const link = document.createElement(`a`);
            link.href = zipUrl;
            link.download = zipFileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(zipUrl);
            showStatusMessage(`ZIP Download Started.`);

        } catch (error) {
            showError(`Failed to create ZIP file: ${error.message}`);
        } finally {
             downloadAllBtn.disabled = false;
             downloadAllBtn.textContent = `Download All as ZIP`;
        }
    });


    document.addEventListener(`DOMContentLoaded`, initializeFFmpeg);

</script>

<script>
/* mwt-result-focus */
(function () {
    if (window.__mwtResultFocus) { return; }
    window.__mwtResultFocus = true;
    var dl = document.getElementById('download-btn');
    if (!dl) { return; }
    var box = document.getElementById('output-container');
    var slot = null;
    var wasHidden = dl.classList.contains('hidden');
    function onClassChange() {
        if (dl.classList.contains('hidden')) { wasHidden = true; return; }
        if (!wasHidden) { return; }
        wasHidden = false;
        if (slot && box && box.parentNode !== slot) { slot.appendChild(box); }
        var target = (slot && slot.firstElementChild) ? slot : (box || dl);
        try {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (e) {
            target.scrollIntoView();
        }
    }
    new MutationObserver(onClassChange).observe(dl, { attributes: true, attributeFilter: ['class'] });
})();
</script>

<script>
function vtiVideo() { return document.getElementById('video-preview'); }

function vtiSyncTime() {
    var v = vtiVideo();
    if (!v || !isFinite(v.currentTime)) return;
    var t = v.currentTime.toFixed(1);
    var input = document.getElementById('time-input');
    var slider = document.getElementById('time-slider');
    var label = document.getElementById('time-value');
    if (input) input.value = t;
    if (slider) slider.value = t;
    if (label) label.textContent = t + 's';
}

function vtiStep(d) {
    var v = vtiVideo();
    if (!v || !v.duration) return;
    v.pause();
    v.currentTime = Math.min(Math.max(0, v.currentTime + d), Math.max(0, v.duration - 0.001));
}

function vtiCapture() {
    var v = vtiVideo();
    if (!v || !v.videoWidth) return;
    v.pause();
    var fmt = (document.getElementById('format-select') || {}).value || 'png';
    var mime = fmt === 'jpg' ? 'image/jpeg' : (fmt === 'webp' ? 'image/webp' : 'image/png');
    var c = document.createElement('canvas');
    c.width = v.videoWidth;
    c.height = v.videoHeight;
    c.getContext('2d').drawImage(v, 0, 0, c.width, c.height);
    c.toBlob(function (blob) {
        if (!blob) return;
        var url = URL.createObjectURL(blob);
        var t = v.currentTime.toFixed(2);
        var base = (window.vtiName || 'video').replace(/\.[^/.]+$/, '');
        var item = document.createElement('div');
        item.className = 'vti-cap';
        var img = document.createElement('img');
        img.src = url;
        img.alt = 'Frame at ' + t + ' s';
        var meta = document.createElement('div');
        meta.className = 'vti-cap-meta';
        var when = document.createElement('span');
        when.textContent = t + ' s \u00b7 ' + c.width + '\u00d7' + c.height;
        var a = document.createElement('a');
        a.href = url;
        a.download = base + '_' + t.replace('.', '_') + 's.' + fmt;
        a.textContent = 'Download';
        a.className = 'vti-cap-dl';
        meta.appendChild(when);
        meta.appendChild(a);
        item.appendChild(img);
        item.appendChild(meta);
        var list = document.getElementById('vti-captures');
        list.classList.remove('hidden');
        list.insertBefore(item, list.firstChild);
        document.dispatchEvent(new CustomEvent('mwt:run-succeeded'));
    }, mime, 0.95);
}

// The tool clears the file input once it has read the video, so keep the
// name from the capture phase, before its own listeners run.
document.addEventListener('change', function (e) {
    var t = e.target;
    if (t && t.id === 'file-input' && t.files && t.files[0]) window.vtiName = t.files[0].name;
}, true);
document.addEventListener('drop', function (e) {
    var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (f) window.vtiName = f.name;
}, true);

document.addEventListener('DOMContentLoaded', function () {
    var v = vtiVideo();
    if (!v) return;
    v.addEventListener('pause', vtiSyncTime);
    v.addEventListener('seeked', function () { if (v.paused) vtiSyncTime(); });
});
</script>
 <span><p style="text-align: right;"><small><a href="#" onclick="displaywidget();">Embed Video to Image Extractor Widget</a></small></p></span> </div>  </div>  <div class="w3-center">  <div class=ma20> </div>    <div class="desktoponly desktop-300" data-desktop="22741838922"> </div> <div class=" mobile-350" data-mobile="22742479556"></div> <div class=ma20> </div> </div> <style>#mwt-loading{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(255,255,255,.75);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);z-index:9999;align-items:center;justify-content:center}#mwt-loading.active{display:flex}@media (min-width:1111px){#mwt-loading{right:342px}}.mwt-loader{display:flex;flex-direction:column;align-items:center;gap:18px}.mwt-ring{width:52px;height:52px;border-radius:50%;border:4px solid #e8e8f0;border-top:4px solid #4a90e2;border-right:4px solid #6a5acd;animation:mwt-spin .9s linear infinite}@keyframes mwt-spin{to{transform:rotate(360deg)}}.mwt-dots{display:flex;gap:8px}.mwt-dots span{width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,#4a90e2,#6a5acd);animation:mwt-bounce 1.4s ease-in-out infinite}.mwt-dots span:nth-child(2){animation-delay:.16s}.mwt-dots span:nth-child(3){animation-delay:.32s}@keyframes mwt-bounce{0%,80%,100%{transform:scale(.5);opacity:.3}40%{transform:scale(1);opacity:1}}</style><script>window.addEventListener("submit", function (e) { var f = e.target; if (f && f.closest && f.closest('#c1')) formsubmit(e); }); function formsubmit(e) { var lo=document.getElementById('mwt-loading');if (e.defaultPrevented) { mwtSubmitWatch(lo); return; } setCookie("formsubmit","1",1);if(lo){e.preventDefault();lo.classList.add('active');var f=e.target,s=e.submitter;if(s&&s.name&&!s.disabled){var hi=document.createElement('input');hi.type='hidden';hi.name=s.name;hi.value=s.value;f.appendChild(hi);}setTimeout(function(){HTMLFormElement.prototype.submit.call(f);},10);} } function mwtSubmitWatch(lo) { if (window.mwtSubmitLeave) { clearTimeout(window.mwtSubmitTimer); window.removeEventListener('beforeunload', window.mwtSubmitLeave); } window.mwtSubmitLeave = function () { clearTimeout(window.mwtSubmitTimer); setCookie("formsubmit","1",1); if (lo) lo.classList.add('active'); }; window.addEventListener('beforeunload', window.mwtSubmitLeave); window.mwtSubmitTimer = setTimeout(function () { window.removeEventListener('beforeunload', window.mwtSubmitLeave); window.mwtSubmitLeave = null; }, 10000); } </script> 
 <div class=ma20> </div><div class="c2"><h2>About Video to Image Extractor </h2> 
<p>
    Easily extract still images from your video files with our <strong>Free Video to Image Extractor</strong>. This tool operates entirely within your browser, ensuring your video files remain private and are never uploaded to any server.
</p>
<p>
    Upload your video, choose whether to extract a single frame at a specific time point or multiple frames at a set interval. Select your desired output image format (PNG, JPG, or WEBP), and click 'Extract'. Preview the results and download your image(s). You can click on the video preview or use the slider to easily find the exact frame you want.
</p>

<h3>Features:</h3>
<ul>
    <li><strong>Client-Side Processing:</strong> Uses FFmpeg.wasm for in-browser video processing. Your files stay on your device.</li>
    <li><strong>Multiple Video Formats:</strong> Supports common video formats like MP4, WEBM, MOV, AVI (browser & FFmpeg support dependent).</li>
    <li><strong>Single Frame Extraction:</strong> Use the video preview's seek bar or the slider control to pinpoint the exact time.</li>
    <li><strong>Multiple Frame Extraction:</strong> Extract images at regular intervals (e.g., every 5 seconds).</li>
    <li><strong>Selectable Output Formats:</strong> Choose between PNG (lossless), JPG (adjustable quality, lossy), and WEBP (modern, versatile).</li>
    <li><strong>Instant Preview:</strong> View the original video (synced with time selection) and preview the extracted image(s).</li>
    <li><strong>Batch Download:</strong> Single images are free; downloading all extracted frames as a ZIP is a member feature.</li>
    <li><strong>Easy Sharing:</strong> Share the tool using your device's native share options or copy the link.</li>
    <li><strong>Progress Tracking:</strong> Monitor the extraction process in real-time.</li>
</ul>

<h3>How to Use:</h3>
<ul>
    <li><strong>Load Engine:</strong> Wait for the converter engine (FFmpeg) to load.</li>
    <li><strong>Upload Video:</strong> Drag & drop your video file or click "Select Video".</li>
    <li><strong>Preview Video:</strong> The video player will load your file. Note the duration.</li>
    <li><strong>Choose Extraction Mode:</strong>
        <ul>
            <li><strong>Single Frame:</strong> Select this option. Click on the video's progress bar or use the slider/input below the video to choose the exact timestamp you want to capture. The video preview will jump to that time.</li>
            <li><strong>Multiple Frames:</strong> Select this option. Enter the time interval (in seconds) between frames you want to extract (e.g., '5' for an image every 5 seconds). The interval must be less than the video duration.</li>
        </ul>
    </li>
    <li><strong>Select Output Format:</strong> Choose PNG, JPG, or WEBP from the dropdown.</li>
    <li><strong>Extract:</strong> Click the "Extract Image(s)" button.</li>
    <li><strong>Wait & Preview:</strong> The progress bar will show the extraction status. Extracted images will appear in the preview area below. Errors will be shown in the status area below the progress bar.</li>
    <li><strong>Download:</strong>
        <ul>
            <li>For a single frame, click "Download Image".</li>
            <li>For multiple frames, single images are free; downloading all frames as a ZIP is a member feature.</li>
        </ul>
    </li>
    <li><strong>Share (Optional):</strong> Click "Share Tool" to open sharing options or copy the tool's URL.</li>
</ul>
<p><strong>Note:</strong> Processing happens in your browser. Larger videos, long durations, or small extraction intervals may take longer and use more system resources.</p>

<h3>Quick Answer</h3>
<p>To extract images from a video, upload it here, choose <strong>Single Frame</strong> and scrub to the exact moment you want, or <strong>Multiple Frames</strong> and set an interval in seconds, pick <strong>PNG, JPG or WEBP</strong>, and click Extract. Single frames are free to download; downloading all frames as a ZIP is a member feature. Use PNG when the frame contains text, UI or graphics and must stay pixel-perfect, JPG when you want the smallest file for a photographic frame, and WEBP when you want both. Extraction runs in your browser through FFmpeg.wasm, so the video is never uploaded and there is no watermark.</p>

<h3>Common Use Cases</h3>
<h4>Choosing a video thumbnail</h4>
<p>Pull several candidate frames and pick the one that works best as a cover image for YouTube, a course page or a blog post.</p>
<h4>Screenshots for documentation and tutorials</h4>
<p>Frames captured from a screen recording give you consistent, correctly sized illustrations without re-shooting anything.</p>
<h4>Evidence and inspection stills</h4>
<p>Dashcam, security and inspection footage often needs a specific moment saved as a still image for a report or a claim.</p>
<h4>Contact sheets and storyboards</h4>
<p>Extracting an image every few seconds produces a visual index of a long video, useful for editing and review.</p>
<h4>Training data and photogrammetry</h4>
<p>Regular interval extraction turns a video walkthrough into an image set for machine-learning datasets or 3D reconstruction.</p>
<h4>Rescuing a photo you did not take</h4>
<p>If the moment was only captured on video, a single extracted frame is the closest thing to a photograph of it.</p>

<h3>Frequently Asked Questions</h3>
<h4>How do I get a still image out of a video?</h4>
<p>Upload the video, select Single Frame, then click on the video's progress bar or drag the slider until the preview shows the moment you want. Choose PNG, JPG or WEBP and click Extract Image(s), then download the image.</p>
<h4>How do I extract many frames at once?</h4>
<p>Choose Multiple Frames and enter the interval in seconds, for example 2 for an image every two seconds. The interval must be shorter than the video. Single images are free; downloading all frames as a ZIP is a member feature.</p>
<h4>Which image format should I choose?</h4>
<p>PNG is lossless, so it is the right choice for frames containing text, screen recordings, line art or anything you will edit further. JPG is lossy and much smaller, which suits photographic frames destined for the web. WEBP gives roughly JPG-sized files at better quality and is supported by all modern browsers.</p>
<h4>What resolution will the extracted images be?</h4>
<p>Each frame comes out at the video's native resolution. A 1080p video yields 1920 by 1080 pixel images and a 4K video yields 3840 by 2160. The tool does not upscale, so an image cannot be sharper than the source video.</p>
<h4>Why does the extracted frame look blurry or blocky?</h4>
<p>Video compression allocates fewer bits to fast-moving frames, so a still pulled from a moving shot can show motion blur and compression artefacts that are invisible during playback. Picking a moment where the camera and subject are still gives a much cleaner image.</p>
<h4>Is my video uploaded to a server?</h4>
<p>No. Extraction runs through FFmpeg compiled to WebAssembly inside your browser tab, so the video stays on your own device.</p>
<h4>How many frames can I extract at once?</h4>
<p>There is no fixed cap, but every image is held in browser memory before it is zipped. A short interval on a long, high-resolution video produces thousands of large images and will exhaust the tab. Increase the interval or split the video first if that happens.</p>
<h4>Can I extract frames at an exact frame number rather than a time?</h4>
<p>Yes. Divide the frame number by the video's frame rate to get the timestamp and seek there, then use the Frame buttons under the preview to step one frame at a time and Capture this frame to save exactly what is on screen, at full resolution. Every capture and extraction from the same video counts as one run.</p>

<h3>Related Tools</h3>
<ul>
  <li><a href="/random-video-thumbnail-generator/">Random Video Thumbnail Generator</a> &mdash; Grab several random frames automatically for thumbnail testing.</li>
  <li><a href="/video-splitter/">Video Splitter</a> &mdash; Cut the section you want to extract frames from.</li>
  <li><a href="/video-cropper/">Video Cropper</a> &mdash; Crop the frame before extracting stills.</li>
  <li><a href="/gif-maker/">GIF Maker</a> &mdash; Turn extracted frames back into an animation.</li>
  <li><a href="/image-resizer/">Image Resizer</a> &mdash; Resize the extracted stills for the web.</li>
</ul>
