    gtagSend('next_step_shown', { source_tool: CFG.module, target_tool: targets.join('|'), rule: hits[0].rule.when, transport_type: 'beacon' });
  }
  /* 20% of browsers are a holdout: the same rules are evaluated and a
     next_step_holdout event is sent, but nothing renders. Comparing their
     visits to the target tools with the shown group's is the only way to
     tell what the line adds over people who would have gone there anyway. */
  function bucket() {
    if (location.hash === '#mwt-next-show') SS('mwt_ns_b', '99');
    var b = parseInt(LS('mwt_ns_b'), 10);
    if (!(b >= 0 && b < 100)) { b = Math.floor(Math.random() * 100); SS('mwt_ns_b', String(b)); }
    return b;
  }
  var HOLDOUT = bucket() < 20;
  function tryRender() {
    if (rendered || !resultEl()) return;
    var hits = evaluate();
