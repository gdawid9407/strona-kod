      if (walled(fb[i].to)) continue;
      out.push(fbHit(fb[i], !out.length));
    }
    return out;
  }
  function withPaid(hits) {
    for (var i = 0; i < hits.length; i++) if (hits[i].rule.paid) return hits;
    var fb = CFG.fb || [];
    for (var j = 0; j < fb.length; j++) {
      if (!fb[j].paid || walled(fb[j].to)) continue;
