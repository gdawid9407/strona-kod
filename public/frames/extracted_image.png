.linkto:after { content: '\002B'; }
.activelinkto:after { content: '\2212'; }

.mwt-tb-wrap { position: relative; display: inline-block; }

.mwt-tb-trigger {
  display: inline-flex !important;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}

.mwt-tb-trigger.linkto:after,
.mwt-tb-trigger.activelinkto:after {
  content: '';
  margin: 0;
  float: none;
}

.mwt-tb-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 999px;
  background: linear-gradient(135deg, #7c4dff, #4a90e2);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
}

.mwt-tb-panel {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  z-index: 1200;
  width: 320px;
  max-width: calc(100vw - 24px);
  padding: 14px;
  text-align: left;
  background: var(--mwt-surface, #fff);
  color: var(--mwt-text, #0f172a);
  border: 1px solid var(--mwt-border, rgba(15, 23, 42, 0.1));
  border-radius: 14px;
  box-shadow: 0 24px 48px -20px rgba(15, 23, 42, 0.45);
}

.mwt-tb-panel #mytoollist ul { max-height: 260px; }


.mwt-tb-label {
  margin: 0 0 6px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(15, 23, 42, 0.5);
}

.mwt-tb-panel textarea {
  width: 100%;
  height: 88px;
  padding: 8px 10px;
  box-sizing: border-box;
  border: 1px solid var(--mwt-border, rgba(15, 23, 42, 0.15));
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.02);
  color: var(--mwt-text, #0f172a);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 12px;
  resize: none;
}

.mwt-tb-btn {
  display: block;
  width: 100%;
  margin-top: 8px;
  padding: 9px 12px;
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(124, 77, 255, 0.95), rgba(74, 144, 226, 0.95));
  color: #fff !important;
  font-size: 14px;
  font-weight: 600;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
}


.mwt-topbar-pro {
  margin-left: 6px;
  border-radius: 8px;
  background: linear-gradient(135deg, #7c4dff, #4a90e2) !important;
  color: #fff !important;
  font-weight: 600;
}

#secondbar .mwt-tb-wrap > .mwt-tb-trigger {
  gap: 8px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 12px !important;
  background: rgba(124, 77, 255, 0.22) !important;
  color: #fff !important;
}

#secondbar .mwt-tb-wrap > .mwt-tb-trigger:hover,
#secondbar .mwt-tb-wrap > .mwt-tb-trigger:focus-visible {
  background: rgba(124, 77, 255, 0.32) !important;
  color: #fff !important;
}

.mwt-tb-empty {
  margin: 8px 0 0;
  font-size: 13px;
  line-height: 1.5;
  color: var(--mwt-muted, rgba(15, 23, 42, 0.6));
}


#secondbar #mytoolbox a {
  color: var(--mwt-link, #4836c4) !important;
}

#secondbar #mytoolbox a:hover {
  text-decoration: underline;
}
</style>

<style>

#mytoolbox ul {
  padding: 0;
  margin: 0;
}
#mytoolbox ul{max-height:300px; width:100%;}
#mytoolbox ul{overflow:hidden; overflow-y:auto; scrollbar-width: thin;}


#mytoolbox ul li {
  cursor: pointer;
  position: relative;
  padding: 10px 10px;
  list-style-type: none;
  background: transparent;
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
  transition: 0.2s;

  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}


#mytoolbox ul li:nth-child(odd) {
  background: rgba(15, 23, 42, 0.02);
}


#mytoolbox ul li:hover {
  background: rgba(124, 77, 255, 0.08);
}


/* Style the closetoolbox button */
#mytoolbox  .closetoolbox {
  position: absolute;
  right: 0;
  top: 0;
  padding: 6px 6px 6px 6px;
}

#mytoolbox .closetoolbox:hover {
  background-color: rgba(239, 68, 68, 0.12);
  color: #ef4444;
}


    .onoffswitch {
    vertical-align: middle;
        
        position: relative; width: 65px;
        -webkit-user-select:none; -moz-user-select:none; -ms-user-select: none;
    }
    .onoffswitch-checkbox {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }
    .onoffswitch-label {
        display: block; overflow: hidden; cursor: pointer;
        border: 2px solid #999999; border-radius: 20px;
    }
    .onoffswitch-inner {
        display: block; width: 200%; margin-left: -100%;
        transition: margin 0.3s ease-in 0s;
    }
    .onoffswitch-inner:before, .onoffswitch-inner:after {
        display: block; float: left; width: 50%; height: 30px; padding: 0; line-height: 30px;
        font-size: 14px; color: white; font-family: Trebuchet, Arial, sans-serif; font-weight: bold;
        box-sizing: border-box;
    }
    .onoffswitch-inner:before {
        content: "ON";
        padding-left: 10px;
        background-color: #34A7C1; color: #FFFFFF;
    }
    .onoffswitch-inner:after {
        content: "OFF";
        padding-right: 10px;
        background-color: #EEEEEE; color: #999999;
        text-align: right;
    }
    .onoffswitch-switch {
        display: block; width: 10px;height:10px; margin: 10px;
        background: #FFFFFF;
        position: absolute; top: 0; bottom: 0;
        right: 31px;
        border: 2px solid #999999; border-radius: 20px;
        transition: all 0.3s ease-in 0s; 
    }
    .onoffswitch-checkbox:checked + .onoffswitch-label .onoffswitch-inner {
        margin-left: 0;
    }
    .onoffswitch-checkbox:checked + .onoffswitch-label .onoffswitch-switch {
        right: 0px; 
    }
    .sliderWrapper{display: inline-block;margin:12px 12px 12px 12px;position:relative;}
    .sliderWrapper div{display: inline-block;line-height:60px;}

    /* ---------- MiniWebtool friendly dialogs (modal + toast) ---------- */
    .mwt-modal-backdrop{
      position:fixed;inset:0;z-index:10000;
      background:rgba(15,23,42,.55);
      display:flex;align-items:center;justify-content:center;
      padding:20px;
      opacity:0;transition:opacity .18s ease;
      font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      color:#0f172a;
    }
    .mwt-modal-backdrop.on{opacity:1}
    .mwt-modal{
      width:100%;max-width:420px;background:#fff;border-radius:16px;
      box-shadow:0 20px 60px -10px rgba(15,23,42,.35),0 8px 20px -8px rgba(15,23,42,.2);
      overflow:hidden;transform:translateY(8px) scale(.98);
      transition:transform .2s cubic-bezier(.2,.9,.3,1.2);
    }
    .mwt-modal-backdrop.on .mwt-modal{transform:translateY(0) scale(1)}
    .mwt-modal-head{
      padding:22px 24px 4px;display:flex;align-items:center;gap:12px;
    }
    .mwt-modal-icon{
      flex:0 0 40px;width:40px;height:40px;border-radius:50%;
      background:linear-gradient(135deg,#a78bfa,#6366f1);
      color:#fff;display:flex;align-items:center;justify-content:center;
      font-size:20px;font-weight:700;
    }
    .mwt-modal-title{
      margin:0;font-size:17px;font-weight:700;color:#0f172a;letter-spacing:-.005em;
    }
    .mwt-modal-body{
      padding:8px 24px 4px;color:#475569;font-size:14.5px;line-height:1.55;
    }
    .mwt-modal-body strong{color:#0f172a}
    .mwt-modal-foot{
      padding:18px 20px 20px;display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap;
    }
    .mwt-modal-btn{
      padding:10px 18px;border-radius:10px;font-weight:600;font-size:14px;
      text-decoration:none;cursor:pointer;border:0;line-height:1.2;
      transition:filter .12s,transform .12s,background .12s;
    }
    .mwt-modal-btn.primary{
      background:linear-gradient(135deg,#6366f1,#7c4dff);color:#fff;
      box-shadow:0 4px 14px rgba(99,102,241,.3);
    }
    .mwt-modal-btn.primary:hover{filter:brightness(1.08);transform:translateY(-1px)}
    .mwt-modal-btn.ghost{background:#f1f5f9;color:#334155}
    .mwt-modal-btn.ghost:hover{background:#e2e8f0}
    .mwt-modal-close{
      position:absolute;top:10px;right:12px;background:none;border:0;
      width:32px;height:32px;border-radius:8px;cursor:pointer;
      color:#556072;font-size:20px;line-height:1;
    }
    .mwt-modal-close:hover{background:#f1f5f9;color:#475569}
    .mwt-modal{position:relative}
    @media (max-width:480px){
      .mwt-modal-head{padding:20px 20px 4px}
      .mwt-modal-body{padding:8px 20px 4px}
      .mwt-modal-foot{padding:16px 16px 18px}
      .mwt-modal-btn{flex:1;text-align:center}
    }

    /* toast — non-blocking info */
    .mwt-toast-wrap{
      position:fixed;z-index:10001;left:50%;bottom:32px;transform:translateX(-50%);
      display:flex;flex-direction:column;gap:8px;pointer-events:none;
    }
    .mwt-toast{
      background:#0f172a;color:#fff;padding:12px 18px;border-radius:10px;
      font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      box-shadow:0 8px 24px -4px rgba(15,23,42,.35);
      max-width:90vw;opacity:0;transform:translateY(12px);
      transition:opacity .2s,transform .2s;pointer-events:auto;
    }
    .mwt-toast.on{opacity:1;transform:translateY(0)}
    .mwt-toast .tick{color:#86efac;margin-right:8px;font-weight:700}
</style>

<div class="mwt-tb-wrap desktoponly">
