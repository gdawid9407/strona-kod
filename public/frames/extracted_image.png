      else v = hit.data[spec];
      if (v === undefined || v === null || v === '') continue;
      v = String(v).slice(0, 200000);
      if (k === 'text') textVal = v;
      fields[k] = v;
    }
    var ui = CFG.ui || {}, nm = String(CFG.name || ''), store = hit.rule.secret ? 'sessionStorage' : 'localStorage';
    try { nm = nm.replace(/[\p{Extended_Pictographic}️‍]/gu, '').replace(/\s+/g, ' ').trim(); } catch (e) {}
    var rec = { to: hit.rule.slug, from: CFG.module, fromName: nm, fields: fields, t: Date.now(),
                note: String(ui.note || '').replace('{name}', nm), clear: ui.clear || '' };
    if (textVal !== null) rec.text = textVal;
    try { localStorage.removeItem('mwt_handoff'); sessionStorage.removeItem('mwt_handoff'); } catch (e) {}
    try { window[store].setItem('mwt_handoff', JSON.stringify(rec)); } catch (e) {}
    SS('mwt_handoff_ref', JSON.stringify({ to: hit.rule.slug, from: CFG.module, t: Date.now() }));
  }
  function mountPoint() {
    if (CFG.mount) { var m = q(CFG.mount); if (visible(m)) return m; }
    var r = resultEl();
    if (!r) return null;
    if (CFG.watch) return r;
    var at = firstBlock(r, false);
    if (!at) return r;
    /* A result that is one tall wrapper (BMI on a phone: gauge, stats,
       insight and steps inside one 3,000px block) would put the card below
       all of it. Step into plain block wrappers taller than 1.5 screens
       and sit after their first real content block instead. */
    for (var depth = 0; depth < 3; depth++) {
      if (at.getBoundingClientRect().height <= (window.innerHeight || 800) * 1.5) break;
      if (!/^(block|flow-root)$/.test(getComputedStyle(at).display)) break;
