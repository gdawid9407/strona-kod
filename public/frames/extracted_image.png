<meta name="theme-color" content="#ffffff">
<style id="mwt-theme-v3">
:root {
  --mwt-bg: #f5f5f1;
  --mwt-grid-line: rgba(28, 27, 46, 0.045);
  --mwt-surface: #ffffff;
  --mwt-surface-2: #f7f6fb;
  --mwt-text: #1c1b2e;
  --mwt-muted: #5b5972;
  --mwt-border: #e4e2ee;
  --mwt-border-strong: #cfccdf;
  --mwt-shadow: 0 1px 2px rgba(25, 24, 49, 0.05), 0 8px 24px rgba(25, 24, 49, 0.07);
  --mwt-shadow-pop: 0 12px 32px rgba(25, 24, 49, 0.16);
  --mwt-radius: 14px;
  --mwt-accent: #5a45e6;
  --mwt-accent-hover: #4836c4;
  --mwt-accent-soft: #edebfc;
  --mwt-accent-text: #4332bd;
  --mwt-on-accent: #ffffff;
  --mwt-jade: #0e9f6e;
  --mwt-jade-deep: #0b7c57;
  --mwt-jade-soft: #e3f6ee;
  --mwt-jade-border: #b5e6d2;
  --mwt-amber: #a34b07;   /* was #b45309: 4.46:1 on --mwt-amber-soft, under AA 4.5 */
  --mwt-amber-soft: #fdf0dc;
  --mwt-header: #1a1930;
  --mwt-header-2: #2a2754;
  --mwt-on-header: #f0effa;
  --mwt-header-pill: rgba(255, 255, 255, 0.10);
  --mwt-header-pill-hover: rgba(255, 255, 255, 0.18);
  --mwt-link: #4836c4;
  --mwt-display-font: "Bricolage Grotesque", "Segoe UI", "PingFang SC", "Hiragino Sans", "Microsoft YaHei", Meiryo, "Malgun Gothic", Arial, sans-serif;
  /* 全站三个字族的唯一来源。工具页一律不许自己再请求 Google Fonts ——
     到 2026-08 为止全站攒了 75 种字族，换一个工具就重下一套，字体缓存基本不命中。
     Inter 覆盖 Latin+Greek+Cyrillic（ru 站同一个文件），且带 tabular figures，
     计算器的数字列才能对齐。CJK/泰文一律走系统栈，不加载 webfont。 */
  --mwt-font: "Inter", system-ui, -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans", "Microsoft YaHei", Meiryo, "Malgun Gothic", "Noto Sans Thai", Arial, sans-serif;
  --mwt-mono-font: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  --mwt-btn-primary: var(--mwt-accent);
  --mwt-btn-primary-hover: var(--mwt-accent-hover);
  --mwt-btn-secondary: #56527a;
  --mwt-btn-secondary-hover: #3f3c5e;
  --mwt-btn-ring: rgba(90, 69, 230, 0.30);
  --mwt-notice-overlay: rgba(16, 15, 33, 0.72);
  color-scheme: light;
}

/* ---- canvas ---- */
html { background-color: var(--mwt-bg); border-bottom: 0; }
body, .w3-main {
  background-color: var(--mwt-bg) !important;
  background-image:
    linear-gradient(var(--mwt-grid-line) 1px, transparent 1px),
    linear-gradient(90deg, var(--mwt-grid-line) 1px, transparent 1px);
  background-size: 32px 32px;
  color: var(--mwt-text);
}
@media screen and (max-width: 993px) { body { background-color: var(--mwt-bg) !important; } }
::selection { background: var(--mwt-accent-soft); color: var(--mwt-accent-text); }
* { scrollbar-width: thin; scrollbar-color: var(--mwt-border-strong) transparent; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: var(--mwt-border-strong); border-radius: 8px; }
::-webkit-scrollbar-track { background: transparent; }
a { color: var(--mwt-link); }
hr { border-top: 1px solid var(--mwt-border); }
h1, h2, h3, h4, .t2, .f1, .f2, .f3 {
  font-family: var(--mwt-display-font);
  letter-spacing: -0.015em;
  color: var(--mwt-text);
}
h1#calculatorstart { line-height: 1.25; }

/* ---- header: first bar ---- */
#topbar { background: var(--mwt-surface); border-bottom: 1px solid var(--mwt-border); }
#firstbar, #firstbar .w3-white, #firstbar .w3-bar { background-color: var(--mwt-surface) !important; color: var(--mwt-text) !important; }
#firstbar .w3-wide {
  font-family: var(--mwt-display-font);
  letter-spacing: 0.01em !important;
  font-weight: 600;
  font-size: 0.92em;
}
#firsttitle { display: flex; align-items: center; justify-content: flex-end; gap: 4px; }
#firsttitle .w3-margin-top { margin-top: 0 !important; }
#firsttitle .w3-bar { display: flex; align-items: center; }
.menu-icon { color: var(--mwt-text) !important; }
#dSpace { background-color: var(--mwt-bg) !important; }
#bc { background: var(--mwt-surface-2) !important; border-bottom: 1px solid var(--mwt-border) !important; }

/* new inline-SVG logo replaces the legacy base64 PNG */
#i1n { background: none !important; display: flex !important; align-items: center; width: 180px; height: 32px; }
#i1n svg { display: block; width: 180px; height: 32px; }

/* ---- header: second bar ---- */
#secondbar, #secondbar.w3-black {
  background-image: linear-gradient(100deg, var(--mwt-header) 0%, var(--mwt-header-2) 100%) !important;
  background-color: var(--mwt-header) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
#secondbar .w3-black { background-color: transparent !important; }
#secondbar a.w3-button, #secondbar button.w3-button {
  color: var(--mwt-on-header) !important;
  font-weight: 500;
}
#navbutton a.w3-green, #navbutton a.w3-button {
  background-color: var(--mwt-header-pill) !important;
  color: var(--mwt-on-header) !important;
}
.search-box {
  background-color: rgba(255, 255, 255, 0.10) !important;
  border: 1.5px solid rgba(255, 255, 255, 0.22) !important;
  color: #ffffff !important;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}
.search-box::placeholder { color: rgba(255, 255, 255, 0.55); }
.search-box:focus {
  border-color: var(--mwt-accent) !important;
  background-color: rgba(255, 255, 255, 0.16) !important;
  box-shadow: 0 0 0 3px var(--mwt-btn-ring);
}
.search-icon { color: rgba(255, 255, 255, 0.85) !important; }
#suggestions {
  background-color: var(--mwt-surface) !important;
  border: 1px solid var(--mwt-border) !important;
  box-shadow: var(--mwt-shadow-pop);
}
#suggestions div { color: var(--mwt-text) !important; }
#suggestions div:hover { background-color: var(--mwt-accent-soft) !important; color: var(--mwt-accent-text) !important; }
#secondbar #suggestions .suggestion-item.highlighted { background: var(--mwt-accent-soft) !important; color: var(--mwt-accent-text) !important; }

/* ---- dropdowns / popovers ---- */
.w3-dropdown-content {
  background-color: var(--mwt-surface) !important;
  color: var(--mwt-text) !important;
  border: 1px solid var(--mwt-border) !important;
  border-radius: 12px;
  box-shadow: var(--mwt-shadow-pop) !important;
  overflow: hidden;
  padding: 4px !important;
}
.w3-dropdown-content a.w3-button, .w3-dropdown-content a.w3-bar-item, .w3-dropdown-content .w3-black {
  background-color: transparent !important;
  color: var(--mwt-text) !important;
  border-radius: 8px;
}
#secondbar .w3-dropdown-content a, #secondbar .w3-dropdown-content .w3-bar-item.w3-button { color: var(--mwt-text) !important; }
.w3-dropdown-content a.w3-button:hover, .w3-dropdown-content a.w3-bar-item:hover,
#secondbar .w3-dropdown-content a:hover, #secondbar .w3-dropdown-content .w3-bar-item.w3-button:hover {
  background-color: var(--mwt-accent-soft) !important;
  color: var(--mwt-accent-text) !important;
}
.category-menu { background-color: var(--mwt-surface) !important; border-bottom: 1px solid var(--mwt-border); box-shadow: var(--mwt-shadow-pop); }
.category-menu a { color: var(--mwt-text) !important; }
.category-menu a:hover { background-color: var(--mwt-accent-soft) !important; }

/* ---- sidebars ---- */
#sidebar1 { background: var(--mwt-surface); border: 1px solid var(--mwt-border); }
#sidebar1 h2 { font-family: var(--mwt-display-font); }
#sidebar, .w3-sidebar { background-color: transparent !important; }
#sidebar a.w3-button, .w3-sidebar a.w3-button {
  color: var(--mwt-text) !important;
  background-color: transparent !important;
  border-radius: 9px;
  transition: background-color 0.15s ease, color 0.15s ease;
}
#sidebar a.w3-button:hover, .w3-sidebar a.w3-button:hover {
  background-color: var(--mwt-accent-soft) !important;
  color: var(--mwt-accent-text) !important;
  box-shadow: none;
}
.tools {
  background-color: var(--mwt-surface-2) !important;
  color: var(--mwt-text) !important;
  border: 1px solid var(--mwt-border) !important;
  border-radius: 10px;
  margin-bottom: 6px;
  font-weight: 600;
}
.tools:hover, .tools.activetool { background-color: var(--mwt-accent-soft) !important; color: var(--mwt-accent-text) !important; }
.panel { background-color: transparent !important; color: var(--mwt-text) !important; }
.reference { color: var(--mwt-muted) !important; }
/* link colour alone is only 1.2:1 against this muted body text */
.reference p a { text-decoration: underline; }

/* right-side card: keep triggers quiet so content stays the focus */
.linkto:after, .activelinkto:after { font-weight: 400; }

/* ---- main content ---- */
.maincontent {
  background-color: var(--mwt-surface) !important;
  border: 1px solid var(--mwt-border);
  border-radius: var(--mwt-radius);
  box-shadow: var(--mwt-shadow);
}

/* form card */
#c1 .ht, #c1 h2 { color: var(--mwt-text); }
.nt { color: var(--mwt-muted) !important; }

/* inputs */
:where(input[type=number], input[type=text], select, textarea) {
  background-color: var(--mwt-surface) !important;
  color: var(--mwt-text) !important;
  border: 1px solid var(--mwt-border-strong) !important;
  border-radius: 10px !important;
  box-shadow: none !important;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
input[type=number]:focus, input[type=text]:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--mwt-accent) !important;
  box-shadow: 0 0 0 3px var(--mwt-btn-ring) !important;
}
.w3-select, .w3-select:hover, .w3-select:focus { background-color: var(--mwt-surface); color: var(--mwt-text); }
.w3-input { background-color: var(--mwt-surface); color: var(--mwt-text); border-bottom: 1px solid var(--mwt-border-strong); }
#send-feedback textarea, #share-result textarea, #linkto textarea, #mytoolbox textarea, #surveystepform textarea {
  background-color: var(--mwt-surface) !important;
  color: var(--mwt-text) !important;
  border: 1px solid var(--mwt-border-strong) !important;
  border-radius: 10px;
}
.w3-check, .w3-radio, input[type=checkbox], input[type=radio], input[type=range] { accent-color: var(--mwt-accent); }

/* ---- buttons ---- */
button, input[type=submit], .w3-btn, .surveystep.finish {
  background-color: var(--mwt-btn-primary);
  color: var(--mwt-on-accent);
  border-radius: 10px;
  font-weight: 600;
  transition: background-color 0.15s ease, transform 0.12s ease, box-shadow 0.15s ease;
}
button:hover, input[type=submit]:hover { background-color: var(--mwt-btn-primary-hover); opacity: 1; }
.w3-btn:hover { box-shadow: 0 6px 16px var(--mwt-btn-ring); transform: translateY(-1px); }
.w3-btn:active { transform: translateY(0); }
button:focus-visible, input[type=submit]:focus-visible, .w3-btn:focus-visible, .w3-button:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px var(--mwt-btn-ring);
}
.w3-green, .w3-hover-green:hover { background-color: var(--mwt-btn-primary) !important; color: var(--mwt-on-accent) !important; }
.w3-teal { background-color: var(--mwt-btn-secondary) !important; }
.w3-btn.w3-white, .w3-button.w3-white, button.w3-white {
  background-color: var(--mwt-surface) !important;
  color: var(--mwt-accent-text) !important;
  border: 1px solid var(--mwt-border-strong) !important;
}
.w3-btn.w3-white:hover, .w3-button.w3-white:hover {
  border-color: var(--mwt-accent) !important;
  background-color: var(--mwt-accent-soft) !important;
}
.w3-border-red { border-color: var(--mwt-border-strong) !important; }
.w3-btn .fa, .w3-button .fa, button .fa { color: inherit !important; }
.w3-btn svg, .w3-button svg, button svg { fill: currentColor; }
.bigbtn { border: 1px solid var(--mwt-border-strong) !important; background-color: var(--mwt-surface-2) !important; color: var(--mwt-text) !important; }
.w3-button:hover { color: var(--mwt-accent-text) !important; background-color: var(--mwt-accent-soft) !important; }
.w3-custom-banner { background-color: var(--mwt-accent-soft); border-radius: 12px; }
.w3-custom-banner-text { color: var(--mwt-text); }
.w3-custom-button { background-color: var(--mwt-accent); color: var(--mwt-on-accent); }
.w3-custom-button:hover { background-color: var(--mwt-accent-hover); }

/* share circles: unified style instead of legacy brand colors */
.shareresult, .surveyshareresult {
  background: var(--mwt-accent-soft) !important;
  color: var(--mwt-accent-text) !important;
  border: 1px solid transparent;
  transition: background-color 0.15s ease, color 0.15s ease, transform 0.12s ease;
}
.shareresult:hover, .surveyshareresult:hover {
  background: var(--mwt-accent) !important;
  color: var(--mwt-on-accent) !important;
  opacity: 1;
  transform: translateY(-2px);
}
#share-result a, #surveyshare-buttons a { color: var(--mwt-accent-text) !important; }
#share-result a:hover, #surveyshare-buttons a:hover { color: var(--mwt-on-accent) !important; }

/* ---- results: the payoff moment gets the jade accent ---- */
.r1, .r3 {
  background: var(--mwt-jade-soft);
  border: 1px solid var(--mwt-jade-border) !important;
  border-radius: 12px;
  color: var(--mwt-text);
  box-shadow: none !important;
}
.r1 { font-family: var(--mwt-display-font); font-weight: 700; }
.highlight { color: var(--mwt-jade-deep); }

/* ---- tables ---- */
.dt, .st { border: 1px solid var(--mwt-border) !important; border-radius: 12px; overflow: hidden; box-shadow: none !important; }
.dt th, .st th { background: var(--mwt-accent-soft) !important; color: var(--mwt-accent-text) !important; border-bottom: 1px solid var(--mwt-border); }
.dt td { border-bottom: 1px solid var(--mwt-border); }
tr.tr1 { background: var(--mwt-surface-2) !important; }
tr.tr2 { background: var(--mwt-surface) !important; }
table { color: var(--mwt-text); }
.zl th, .m2 { background: var(--mwt-surface-2); border-bottom: 1px solid var(--mwt-border); }
.z6 { background: var(--mwt-surface-2); border-bottom: 1px solid var(--mwt-border); }
.zf, .zfo, .zl, .c2, .z4, .z5 { border-color: var(--mwt-border); }
.zft { background: var(--mwt-surface-2); }
.m2 li { border-right: 1px solid var(--mwt-border); }
.m2 li a { color: var(--mwt-muted); }
.m2 a.on:link, .m2 a.on:visited, .m2 a:hover, .m2 a:active { background: var(--mwt-accent-soft); color: var(--mwt-accent-text); }

/* ---- badges ---- */
.featured-badge { background-color: var(--mwt-amber-soft); color: var(--mwt-amber); border-radius: 999px; font-weight: 600; }
.badge-new { background-color: var(--mwt-accent); color: var(--mwt-on-accent); }
.badge-featured { background-color: var(--mwt-amber); color: #ffffff; }

/* ---- footer ---- */
footer.w3-panel, footer.w3-light-grey, #footer {
  background-color: transparent !important;
  color: var(--mwt-muted) !important;
  box-shadow: none !important;
  border: 0;
  border-top: 1px solid var(--mwt-border);
  border-radius: 0;
  opacity: 1 !important;
}
footer a { color: var(--mwt-muted) !important; }
footer a:hover { color: var(--mwt-accent-text) !important; }

/* ---- misc legacy surfaces ---- */
.w3-light-grey { background-color: var(--mwt-surface-2) !important; color: var(--mwt-text) !important; }
.w3-white, .w3-hover-white:hover { background-color: var(--mwt-surface) !important; color: var(--mwt-text) !important; }
.content-section { color: var(--mwt-text); }
.surveymodal-content { background-color: var(--mwt-surface); color: var(--mwt-text); border-radius: var(--mwt-radius); }
.surveymodal-body { background-color: var(--mwt-surface) !important; color: var(--mwt-text) !important; }
.surveystepcontainer { background-color: var(--mwt-surface); }
.loaderpdf { border-color: var(--mwt-surface-2); border-top-color: var(--mwt-accent); }
.sliderimg, .surveyslider { background: var(--mwt-border-strong); border-radius: 999px; }
.sliderimg::-webkit-slider-thumb { background: var(--mwt-accent); border-radius: 50%; }
.sliderimg::-moz-range-thumb { background: var(--mwt-accent); }

/* dark mode is retired: hide the legacy JS-injected toggle */
#darkmode { display: none !important; }

/* ---- share menu: text-only entries, consistent alignment ---- */
#secondbar .w3-dropdown-content i.fa { display: none !important; }
#secondbar .w3-dropdown-content a.w3-bar-item { display: block; }

/* ---- extra glyphs for result share circles (FA 4.3 webfont already loaded) ---- */
.fa-mwt-reddit:before { content: "\f1a1"; }
.fa-mwt-send:before { content: "\f1d8"; }
.fa-mwt-link:before { content: "\f0c1"; }
.fa-mwt-check:before { content: "\f00c"; }
.shareresult.mwt-copied { background: var(--mwt-jade) !important; color: #ffffff !important; }

/* ---- related tools: contextual card at the top of the sidebar (tool pages) ---- */
#side-related {
  margin: 12px 8px 16px;
  padding: 10px 8px 8px;
  background: linear-gradient(180deg, rgba(90, 69, 230, 0.07), rgba(90, 69, 230, 0.02));
  border: 1px solid rgba(90, 69, 230, 0.14);
  border-radius: 12px;
}
.mwt-rel-eyebrow, #mwt-rel-panel .mwt-rel-title {
  font-family: var(--mwt-display-font);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--mwt-accent-text);
}
.mwt-rel-eyebrow { margin: 2px 8px 8px; }
.mwt-rel-group {
  font-family: var(--mwt-display-font);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--mwt-muted, #64748b);
  margin: 10px 8px 4px;
}
.mwt-rel-group-next { color: var(--mwt-accent-text); }
.mwt-rel-list .mwt-rel-group:first-child, #mwt-rel-panel .mwt-rel-group:first-of-type { margin-top: 4px; }
#sidebar1 a.mwt-rel-current {
  display: flex !important;
  align-items: center;
  gap: 9px;
  white-space: normal;
  overflow-wrap: anywhere;
  background: var(--mwt-surface) !important;
  border: 1px solid rgba(90, 69, 230, 0.22);
  border-radius: 10px;
  font-family: var(--mwt-display-font);
  font-weight: 700;
  color: var(--mwt-text) !important;
  box-shadow: 0 1px 2px rgba(25, 24, 49, 0.06);
  margin-bottom: 4px;
}
#sidebar1 a.mwt-rel-current:hover {
  background: var(--mwt-surface) !important;
  color: var(--mwt-text) !important;
}
#sidebar1 a.mwt-rel-current::before {
  content: "";
  flex: 0 0 auto;
  width: 9px;
  height: 9px;
  border-radius: 3px;
  background: var(--mwt-jade);
}
#side-related .mwt-rel-list a {
  padding: 8px 10px !important;
  border-radius: 9px;
  white-space: normal;
  overflow-wrap: anywhere;
}
@media screen and (max-width: 993px) { #side-related { display: none; } }

/* ---- guides: own card above the related-tools card (articles, not tools) ---- */
#side-guides {
  margin: 12px 8px 0;
  padding: 10px 8px 8px;
  background: linear-gradient(180deg, rgba(16, 141, 106, 0.08), rgba(16, 141, 106, 0.02));
  border: 1px solid rgba(16, 141, 106, 0.18);
  border-radius: 12px;
}
#side-guides .mwt-guide-eyebrow {
  font-family: var(--mwt-display-font);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--mwt-jade);
  margin: 2px 8px 8px;
}
#sidebar1 a.mwt-guide-item, #mwt-rel-panel a.mwt-guide-item {
  display: flex !important;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 10px !important;
  border-radius: 9px;
  white-space: normal;
  overflow-wrap: anywhere;
  background: var(--mwt-surface) !important;
  border: 1px solid rgba(16, 141, 106, 0.20);
  color: var(--mwt-text) !important;
  margin-bottom: 4px;
}
#sidebar1 a.mwt-guide-item:hover, #mwt-rel-panel a.mwt-guide-item:hover {
  border-color: var(--mwt-jade);
  color: var(--mwt-text) !important;
}
a.mwt-guide-item::before {
  content: "";
  flex: 0 0 auto;
  width: 9px;
  height: 9px;
  margin-top: 5px;
  border-radius: 50%;
  background: var(--mwt-jade);
}
@media screen and (max-width: 993px) { #side-guides { display: none; } }
#mwt-rel-panel .mwt-guide-title { color: var(--mwt-jade); }

/* ---- related tools: mobile top-bar toggle + slide-down menu ---- */
#mwt-rel-btn {
  padding: 8px 10px !important;
  border-radius: 12px !important;
  background: var(--mwt-header-pill) !important;
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: var(--mwt-on-header) !important;
  display: inline-flex;
  align-items: center;
}
#mwt-rel-btn svg { width: 18px !important; height: 18px !important; }
#mwt-rel-panel {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--mwt-surface);
  border-bottom: 1px solid var(--mwt-border);
  border-radius: 0 0 var(--mwt-radius) var(--mwt-radius);
  box-shadow: var(--mwt-shadow-pop);
  padding: 4px 0 6px;
  max-height: 62vh;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}
#mwt-rel-panel.show { display: block; animation: mwtRelDown 0.22s ease; }
@keyframes mwtRelDown {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: none; }
}
#mwt-rel-panel .mwt-rel-title { margin: 12px 18px 6px; }
#mwt-rel-panel a.w3-button {
  display: flex !important;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  box-sizing: border-box;
  text-align: left;
  white-space: normal;
  padding: 13px 18px !important;
  background: transparent !important;
  color: var(--mwt-text) !important;
  font-weight: 500;
  border-bottom: 1px solid var(--mwt-border);
  border-radius: 0;
}
#mwt-rel-panel a.w3-button:last-child { border-bottom: 0; }
#mwt-rel-panel a.w3-button::after {
  content: "\203A";
  flex: 0 0 auto;
  color: var(--mwt-border-strong);
  font-size: 20px;
  line-height: 1;
}
#mwt-rel-panel a.w3-button:hover, #mwt-rel-panel a.w3-button:active {
  background: var(--mwt-accent-soft) !important;
  color: var(--mwt-accent-text) !important;
}
</style>
<script>

(function () {
  try { localStorage.setItem('preferredpagemode', 'light'); } catch (e) {}

  var LOGO =
    '<svg width="180" height="32" viewBox="0 0 180 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">' +
    '<defs><linearGradient id="mwt-lg" x1="0" y1="0" x2="1" y2="1">' +
    '<stop offset="0" stop-color="#6a55f0"/><stop offset="1" stop-color="#4836c4"/>' +
    '</linearGradient></defs>' +
    '<rect x="1" y="3" width="26" height="26" rx="7" fill="url(#mwt-lg)"/>' +
    '<rect x="6.5" y="8.5" width="6.5" height="6.5" rx="2" fill="#ffffff" opacity="0.95"/>' +
    '<rect x="15" y="8.5" width="6.5" height="6.5" rx="2" fill="#ffffff" opacity="0.55"/>' +
    '<rect x="6.5" y="17" width="6.5" height="6.5" rx="2" fill="#ffffff" opacity="0.55"/>' +
    '<rect x="15" y="17" width="6.5" height="6.5" rx="3.25" fill="#2fd39b"/>' +
    '<text x="33" y="23.5" font-family="\'Bricolage Grotesque\',\'Segoe UI\',Arial,sans-serif" font-size="20" font-weight="700" letter-spacing="-0.3">' +
    '<tspan fill="#1c1b2e">mini</tspan><tspan fill="#5a45e6">Webtool</tspan>' +
    '</text></svg>';

  function injectLogo() {
    var logo = document.getElementById('i1n');
    if (logo) {
      if (!logo.querySelector('svg')) { logo.innerHTML = LOGO; }
      return true;
    }
    return false;
  }

  (function early() {
    if (injectLogo() || document.readyState !== 'loading') { return; }
    requestAnimationFrame(early);
  })();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', injectLogo);
  } else {
    injectLogo();
  }
})();
</script>
