center; justify-content: space-between; padding: 10px 20px; background-color: #f5f0ff; border-radius: 5px; } .w3-custom-banner-text { color: #4a4a4a; } .w3-custom-button { background-color: #7c4dff; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; } .w3-custom-button:hover { background-color: #6a3ecc; }#lang-footer{position:relative;display:inline-block;text-align:left;vertical-align:baseline}#lang-footer>summary{display:inline;list-style:none;cursor:pointer}#lang-footer>summary::-webkit-details-marker{display:none}#lang-footer>summary:hover{text-decoration:underline}#lang-footer>summary svg{width:1em;height:1em;vertical-align:-.12em;margin-right:.35em;fill:currentColor}#lang-footer>summary::after{content:"\25be";margin-left:.35em;font-size:.8em}#lang-footer[open]>summary::after{content:"\25b4"}#lang-footer-list{position:absolute;bottom:calc(100% + 10px);left:50%;transform:translateX(-50%);z-index:30;min-width:200px;max-height:60vh;overflow-y:auto;padding:6px;background:#fff;border:1px solid #ccd3da;border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,.18);text-align:left}#lang-footer-list a{display:block;width:auto;margin:0;padding:7px 14px;border:none;border-radius:6px;background:none;font-size:.9rem;line-height:1.3;color:#333;text-decoration:none;white-space:nowrap}#lang-footer-list a:hover{background:#eef2f6;color:#111;text-decoration:none}body.darkpagetheme #lang-footer-list{background:#1d2a35;border-color:#38444d}body.darkpagetheme #lang-footer-list a{color:#dfe6ec}body.darkpagetheme #lang-footer-list a:hover{background:#38444d;color:#fff}</style><style id="mwt-ui-refresh">

	  :root {
    --mwt-bg: #f6f7fb;
    --mwt-surface: #ffffff;
    --mwt-text: #0f172a;
    --mwt-muted: #475569;
    --mwt-border: rgba(15, 23, 42, 0.12);
    --mwt-shadow: 0 10px 30px rgba(15, 23, 42, 0.10);
    --mwt-radius: 16px;
    --mwt-accent: #7c4dff;
    --mwt-btn-primary: #1e293b; /* slate-800 */
    --mwt-btn-primary-hover: #0f172a; /* slate-900 */
    --mwt-btn-secondary: #475569; /* slate-600 */
    --mwt-btn-secondary-hover: #334155; /* slate-700 */
    --mwt-btn-ring: rgba(124, 77, 255, 0.35);
	    --mwt-notice-overlay: rgba(2, 6, 23, 0.72);
	  }

	  /* Support notice modal (non-members). Scoped to avoid affecting other modals. */
	  #mwt-notice-1791364122[hidden] {
	    display: none !important;
	  }

	  #mwt-notice-1791364122 {
	    position: fixed;
	    inset: 0;
	    z-index: 2147483647;
	    display: grid;
	    place-items: center;
	    padding: 18px;
	    opacity: 0;
	    transition: opacity 160ms ease;
	  }

	  #mwt-notice-1791364122.mwt-notice-open {
	    opacity: 1;
	  }

	  #mwt-notice-1791364122.mwt-notice-closing {
	    opacity: 0;
	  }

	  #mwt-notice-1791364122 .mwt-notice-backdrop {
	    position: absolute;
	    inset: 0;
	    background: var(--mwt-notice-overlay);
	    backdrop-filter: blur(10px);
	    -webkit-backdrop-filter: blur(10px);
	  }

	  #mwt-notice-1791364122 .mwt-notice-dialog {
	    position: relative;
	    width: min(560px, calc(100vw - 32px));
	    max-height: min(84vh, 720px);
	    overflow: auto;
	    background: var(--mwt-surface);
	    color: var(--mwt-text);
	    border: 1px solid rgba(15, 23, 42, 0.12);
	    border-radius: 18px;
	    box-shadow: 0 32px 90px rgba(2, 6, 23, 0.38);
	    opacity: 0;
	    transform: translateY(12px) scale(0.99);
	    transition: transform 180ms ease, opacity 180ms ease;
	  }

	  #mwt-notice-1791364122.mwt-notice-open .mwt-notice-dialog {
	    opacity: 1;
	    transform: translateY(0) scale(1);
	  }

	  #mwt-notice-1791364122.mwt-notice-closing .mwt-notice-dialog {
	    opacity: 0;
	    transform: translateY(14px) scale(0.99);
	  }

	  #mwt-notice-1791364122 .mwt-notice-dialog::before {
	    content: "";
	    position: sticky;
	    top: 0;
	    display: block;
	    height: 4px;
	    background: linear-gradient(90deg, rgba(124, 77, 255, 0.95), rgba(74, 144, 226, 0.95));
	    border-top-left-radius: 18px;
	    border-top-right-radius: 18px;
	    z-index: 1;
	  }

	  @media (prefers-reduced-motion: reduce) {
	    #mwt-notice-1791364122 {
	      transition: none;
	    }

	    #mwt-notice-1791364122 .mwt-notice-dialog {
	      transition: none;
	      transform: none;
	      opacity: 1;
	    }
	  }

	  #mwt-notice-1791364122 .mwt-notice-header {
	    display: flex;
	    gap: 12px;
	    align-items: flex-start;
	    padding: 18px 18px 0;
	  }

	  #mwt-notice-1791364122 .mwt-notice-icon {
	    width: 44px;
	    height: 44px;
	    border-radius: 14px;
	    background: linear-gradient(135deg, rgba(124, 77, 255, 0.95), rgba(74, 144, 226, 0.95));
	    box-shadow: 0 12px 24px rgba(124, 77, 255, 0.25);
	    display: grid;
	    place-items: center;
	    color: #ffffff;
	    flex: 0 0 auto;
	  }

	  #mwt-notice-1791364122 .mwt-notice-eyebrow {
	    font-size: 12px;
	    letter-spacing: 0.08em;
	    text-transform: uppercase;
	    color: var(--mwt-muted);
	    margin: 2px 0 2px;
	  }

	  #mwt-notice-1791364122 .mwt-notice-title {
	    margin: 0;
	    font-size: 1.25rem;
	    line-height: 1.25;
	  }

	  #mwt-notice-1791364122 .mwt-notice-content {
	    padding: 0 18px 18px;
	  }

	  #mwt-notice-1791364122 .mwt-notice-text {
	    margin: 10px 0 10px;
	    color: var(--mwt-muted);
	    overflow-wrap: anywhere;
	  }

	  #mwt-notice-1791364122 .mwt-notice-list {
	    margin: 0;
	    padding-left: 18px;
	    color: var(--mwt-muted);
	  }

	  #mwt-notice-1791364122 .mwt-notice-actions {
	    margin-top: 14px;
	    display: flex;
	    gap: 10px;
	    flex-wrap: wrap;
	  }

	  #mwt-notice-1791364122 .mwt-notice-btn {
	    display: inline-flex;
	    align-items: center;
	    justify-content: center;
	    padding: 10px 12px;
	    border-radius: 12px;
	    font-weight: 600;
	    text-decoration: none;
	    border: 1px solid transparent;
	    cursor: pointer;
	    user-select: none;
	    line-height: 1.1;
	  }

	  #mwt-notice-1791364122 .mwt-notice-btn-primary {
	    background: linear-gradient(135deg, rgba(124, 77, 255, 0.95), rgba(74, 144, 226, 0.95));
	    color: #ffffff !important;
	    box-shadow: 0 12px 26px rgba(15, 23, 42, 0.20);
	  }

	  #mwt-notice-1791364122 .mwt-notice-btn-primary:hover {
	    filter: brightness(1.04);
	  }

	  #mwt-notice-1791364122 .mwt-notice-btn-secondary {
	    background: rgba(15, 23, 42, 0.06);
	    color: var(--mwt-text) !important;
	    border-color: rgba(15, 23, 42, 0.12);
	  }

	  #mwt-notice-1791364122 .mwt-notice-btn-secondary:hover {
	    background: rgba(15, 23, 42, 0.09);
	  }

	  #mwt-notice-1791364122 .mwt-notice-footer {
	    margin-top: 12px;
	    padding-top: 12px;
