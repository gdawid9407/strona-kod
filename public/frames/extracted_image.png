  function handoff(hit) {
    if (hit.rule.fb && !hit.rule.carry) {
      SS('mwt_handoff_ref', JSON.stringify({ to: hit.rule.slug, from: CFG.module, t: Date.now() }));
      return;
    }
    var fields = {}, textVal = null, c = hit.rule.carry || {};
    for (var k in c) {
      if (!Object.prototype.hasOwnProperty.call(c, k)) continue;
      var spec = String(c[k]), v;
      if (spec.charAt(0) === '=') v = spec.slice(1);
